---
// Pagine dei punti di partenza in italiano: /escursioni-la-maddalena-da-palau/ e /escursioni-la-maddalena-da-cannigione/.
// Il modello è in src/viste/Imbarco.astro (lo stesso della versione inglese).
import Imbarco from '../viste/Imbarco.astro';
import { pagineImbarco } from '../data/imbarchi.js';

export function getStaticPaths() {
  return pagineImbarco.map((p) => ({ params: { imbarco: p.href.replaceAll('/', '') }, props: { p } }));
}
const { p } = Astro.props;
---
<Imbarco p={p} />
