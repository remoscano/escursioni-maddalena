---
// English tour pages: same template as the Italian ones (src/viste/Escursione.astro), texts in src/data/en/escursioni.js.
import Escursione from '../../../viste/Escursione.astro';
import { escursioni } from '../../../data/en/escursioni.js';

export function getStaticPaths() {
  return escursioni.map((e) => ({ params: { slug: e.indirizzo }, props: { e } }));
}
const { e } = Astro.props;
---
<Escursione e={e} />
