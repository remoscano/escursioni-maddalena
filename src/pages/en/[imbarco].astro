---
// English departure pages (Palau, Cannigione): same template as the Italian ones (src/viste/Imbarco.astro).
import Imbarco from '../../viste/Imbarco.astro';
import { pagineImbarco } from '../../data/en/imbarchi.js';

export function getStaticPaths() {
  return pagineImbarco.map((p) => ({ params: { imbarco: p.href.split('/').filter(Boolean).at(-1) }, props: { p } }));
}
const { p } = Astro.props;
---
<Imbarco p={p} />
