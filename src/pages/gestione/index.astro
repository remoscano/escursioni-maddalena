      { nome: 'Spese', righe: [['Giorno', 'Gommone', 'Skipper', 'Litri', 'Carburante €', '€ al litro', 'Bevande €', 'Cibo €', 'Altro €', 'Totale €', 'Note', 'Ultima modifica'],
        ...d.rendiconti.map((r: any) => [r.data, r.gommone, r.skipper, r.litri, r.carburante, r.litri ? Math.round((r.carburante / r.litri) * 1000) / 1000 : null, r.bevande, r.cibo, r.altro, r.totale, r.nessunaSpesa ? `Nessuna spesa${r.note ? ` · ${r.note}` : ''}` : r.note || '', String(r.aggiornatoIl || '').slice(0, 16).replace('T', ' ')])] },
      { nome: 'Per gommone', righe: [intest, ...d.perGommone.map(riga), riga(d.totale)] },
      { nome: 'Per skipper', righe: [intest, ...d.perSkipper.map(riga)] },
      { nome: 'Per mese', righe: [intest, ...d.perMese.map(riga)] },
      { nome: 'Giorni senza spese', righe: [['Giorno', 'Gommone', 'Prenotazioni', 'Persone', 'Skipper'], ...d.mancanti.map((x: any) => [x.data, x.gommone, x.prenotazioni, x.persone, x.skipper || ''])] },
    ]);
  });

  // ---------- Offerte: promozioni, codici, buoni, extra ----------
  const TESTO_SOGLIA: Record<string, string> = { anticipo: 'Almeno quanti giorni prima', 'ultimo-minuto': 'Entro quante ore dalla partenza', gruppo: 'Da quante persone', weekend: '' };
  $('#r-tipo').addEventListener('change', () => {
    const tipo = $<HTMLSelectElement>('#r-tipo').value;
    $('[data-soglia]').hidden = tipo === 'weekend';
    $('[data-etichetta-soglia]').textContent = TESTO_SOGLIA[tipo];
    $('[data-etichetta-pct]').textContent = tipo === 'weekend' ? 'Aumento %' : 'Sconto %';
  });
  async function caricaOfferte() {
    try {
      const d = await api('/api/gestione/offerte');
      const stato = (attivo: boolean) => `<span class="stato ${attivo ? 'stato--ok' : ''}">${attivo ? 'Attivo' : 'Spento'}</span>`;
      $('[data-regole]').innerHTML = d.regole.length ? d.regole.map((r: any) => `<tr><td><strong>${h(r.nome || NOMI_REGOLE[r.tipo])}</strong></td>
        <td>${r.tipo === 'weekend' ? `+${r.percentuale}% sabato e domenica` : `−${r.percentuale}% ${r.tipo === 'anticipo' ? `prenotando almeno ${r.soglia} giorni prima` : r.tipo === 'ultimo-minuto' ? `nelle ${r.soglia} ore prima della partenza` : `da ${r.soglia} persone`}`}</td>
        <td>${h(nomeEscursioni(r.escursioni))}${periodoTesto(r.dal, r.al) ? `<br><span class="testo-2">${h(periodoTesto(r.dal, r.al))}</span>` : ''}</td><td>${stato(r.attiva)}</td>
        <td><div class="azioni-riga"><button class="btn btn--bordo btn--piccolo" type="button" data-off="regola" data-az="${r.attiva ? 'disattiva' : 'attiva'}" data-id="${r.id}">${r.attiva ? 'Spegni' : 'Accendi'}</button><button class="btn btn--bordo btn--piccolo" type="button" data-off="regola" data-az="elimina" data-id="${r.id}">Elimina</button></div></td></tr>`).join('')
        : '<tr><td class="vuota" colspan="5">Nessuna promozione.</td></tr>';
      $('[data-codici]').innerHTML = d.codici.length ? d.codici.map((c: any) => `<tr><td><strong>${h(c.codice)}</strong>${c.note ? `<br><span class="testo-2">${h(c.note)}</span>` : ''}</td>
        <td>${c.tipo === 'percentuale' ? `−${c.valore}%` : `−${euro(c.valore)}`}</td><td>${h(nomeEscursioni(c.escursioni))}${periodoTesto(c.dal, c.al) ? `<br><span class="testo-2">${h(periodoTesto(c.dal, c.al))}</span>` : ''}</td>
        <td class="num">${c.usati}${c.usiMax ? ` / ${c.usiMax}` : ''}</td><td class="num">${euro(c.scontato)}</td><td>${stato(c.attivo)}</td>
        <td><button class="btn btn--bordo btn--piccolo" type="button" data-off="codice" data-az="${c.attivo ? 'disattiva' : 'attiva'}" data-id="${c.id}">${c.attivo ? 'Spegni' : 'Accendi'}</button></td></tr>`).join('')
        : '<tr><td class="vuota" colspan="7">Nessun codice.</td></tr>';
      $('[data-buoni]').innerHTML = d.buoni.length ? d.buoni.map((b: any) => `<tr><td><strong>${h(b.codice)}</strong><br><span class="testo-2">${h(b.acquirente || '')}${b.email ? ` · ${h(b.email)}` : ''}${b.creatoDa !== 'cliente' ? ' · fatto dall\'ufficio' : ''}</span></td>
        <td>${h(b.destinatario || '')}</td><td class="num">${euro(b.valore)}</td><td class="num">${euro(b.saldo)}</td><td>${b.al ? h(dataBreve(b.al)) : '—'}</td>
        <td>${b.stato === 'attivo' ? (b.al && b.al < oggiRoma() ? '<span class="stato">Scaduto</span>' : '<span class="stato stato--ok">Attivo</span>') : `<span class="stato stato--annullata">${h(b.stato)}</span>`}</td>
        <td><div class="azioni-riga"><a class="btn btn--bordo btn--piccolo" href="/buono-regalo/esito/?codice=${encodeURIComponent(b.codice)}&t=${encodeURIComponent(b.token)}" target="_blank" rel="noopener">Apri</a>${b.stato === 'attivo' ? `<button class="btn btn--bordo btn--piccolo" type="button" data-off="buono" data-az="annulla" data-id="${b.id}" data-rimborsabile="${b.saldo === b.valore && ['sumup', 'paypal', 'prova'].includes(b.metodo) ? 1 : 0}">Annulla</button>` : ''}</div></td></tr>`).join('')
        : '<tr><td class="vuota" colspan="7">Nessun buono.</td></tr>';
      $('[data-extra-gestione]').innerHTML = d.extra.length ? d.extra.map((e: any) => `<tr><td><strong>${h(e.nome)}</strong><br><span class="testo-2">${h(nomeEscursioni(e.escursioni))}${e.descrizione ? ` · ${h(e.descrizione)}` : ''}</span></td>
        <td class="num">${euro(e.prezzo)}${e.modo === 'persona' ? ' a persona' : ''}</td><td>${e.maxGiorno ?? 'senza limite'}</td><td class="num">${e.venduti}</td><td>${stato(e.attivo)}</td>
        <td><button class="btn btn--bordo btn--piccolo" type="button" data-off="extra" data-az="${e.attivo ? 'disattiva' : 'attiva'}" data-id="${e.id}">${e.attivo ? 'Spegni' : 'Accendi'}</button></td></tr>`).join('')
        : '<tr><td class="vuota" colspan="6">Nessun extra.</td></tr>';
    } catch (e) { errore(e); }
  }
  $('[data-pannello="offerte"]').addEventListener('click', async (ev) => {
    const b = (ev.target as Element).closest<HTMLElement>('[data-off]');
    if (!b) return;
    pulisciErrore();
    let rimborsa = false;
    if (b.dataset.off === 'buono') {
      if (!window.confirm('Annullare il buono? Non si potrà più usare.')) return;
      rimborsa = b.dataset.rimborsabile === '1' && window.confirm('Il buono non è mai stato usato ed è stato pagato online: vuoi anche rimborsarlo in automatico?');
    }
    if (b.dataset.az === 'elimina' && !window.confirm('Eliminare la promozione?')) return;
    try { await api('/api/gestione/offerte', { corpo: { tipo: b.dataset.off, azione: b.dataset.az, id: Number(b.dataset.id), rimborsa } }); caricaOfferte(); } catch (e) { errore(e); }
  });
  const inviaOfferta = (selettore: string, tipo: string, dopo?: (r: any, f: HTMLFormElement) => void) => $(selettore).addEventListener('submit', async (ev) => {
    ev.preventDefault(); pulisciErrore();
    const f = ev.target as HTMLFormElement;
    const corpo: any = Object.fromEntries(new FormData(f).entries());
    if (f.pagato) corpo.pagato = f.pagato.checked;
    try { const r = await api('/api/gestione/offerte', { corpo: { tipo, azione: 'crea', ...corpo } }); f.reset(); dopo?.(r, f); caricaOfferte(); } catch (e) { errore(e); }
  });
  inviaOfferta('[data-modulo-regola]', 'regola', () => $('#r-tipo').dispatchEvent(new Event('change')));
  inviaOfferta('[data-modulo-codice]', 'codice');
  inviaOfferta('[data-modulo-extra]', 'extra');
  inviaOfferta('[data-modulo-buono]', 'buono', (r) => {
    $('[data-esito-buono]').innerHTML = `<div class="messaggio-ok">Buono creato: <strong>${h(r.codice)}</strong>. <a href="${h(r.link)}" target="_blank" rel="noopener">Apri il buono da stampare</a> · <button type="button" class="btn btn--bordo btn--piccolo" data-copia="${h(r.link)}">Copia il link</button></div>`;
  });

  // ---------- Volantini ----------
  async function caricaVolantini() {
    try {
      const d = await api('/api/gestione/campagne');
      $('[data-volantini]').innerHTML = d.campagne.length ? d.campagne.map((c: any) => `<tr><td><strong>${h(c.nome)}</strong><br><span class="testo-2">${h(c.codice)} · ${h(c.link)}</span>${c.attiva ? '' : '<br><span class="stato">Spento</span>'}</td>
        <td class="num">${c.visite}</td><td class="num">${c.prenotazioni}${c.visite ? `<br><span class="testo-2">${Math.round((c.prenotazioni / c.visite) * 100)}%</span>` : ''}</td><td class="num">${euro(c.incasso)}</td>
        <td><div class="azioni-riga"><span class="qr-mini">${svgQr(c.link, `QR ${c.nome}`)}</span><button class="btn btn--bordo btn--piccolo" type="button" data-png="${h(c.link)}" data-nome="${h(c.codice)}">Scarica QR</button><button class="btn btn--bordo btn--piccolo" type="button" data-copia="${h(c.link)}">Copia link</button><button class="btn btn--bordo btn--piccolo" type="button" data-vol-az="${c.attiva ? 'disattiva' : 'attiva'}" data-id="${c.id}">${c.attiva ? 'Spegni' : 'Accendi'}</button></div></td></tr>`).join('')
        : '<tr><td class="vuota" colspan="5">Nessun volantino.</td></tr>';
    } catch (e) { errore(e); }
  }
  $('[data-volantini]').addEventListener('click', async (ev) => {
    const png = (ev.target as Element).closest<HTMLElement>('[data-png]');
    if (png) { const a = document.createElement('a'); a.href = pngQr(png.dataset.png!, 1200, png.dataset.png!.replace(/^https?:\/\//, '')); a.download = `qr-${png.dataset.nome}.png`; a.click(); return; }
    const b = (ev.target as Element).closest<HTMLElement>('[data-vol-az]');
    if (!b) return;
    try { await api('/api/gestione/campagne', { corpo: { azione: b.dataset.volAz, id: Number(b.dataset.id) } }); caricaVolantini(); } catch (e) { errore(e); }
  });
  $('[data-modulo-volantino]').addEventListener('submit', async (ev) => {
    ev.preventDefault(); pulisciErrore();
    const f = ev.target as HTMLFormElement;
    try { await api('/api/gestione/campagne', { corpo: { azione: 'crea', nome: f.nome.value, codice: f.codice.value } }); f.reset(); caricaVolantini(); } catch (e) { errore(e); }
  });

  // ---------- Account: skipper ed email automatiche ----------
  async function caricaSkipper() {
    $('[data-indirizzo-imbarco]').textContent = `${location.host}/imbarco/`;
    try {
      const d = await api('/api/gestione/utenti');
      $('[data-skipper]').innerHTML = d.skipper.length ? d.skipper.map((u: any) => `<tr><td><strong>${h(u.nome)}</strong><br><span class="testo-2">${h(u.email)}${u.attivo ? '' : ' · disattivato'}</span></td>
        <td>${u.ultimo_accesso ? h(new Date(u.ultimo_accesso).toLocaleString('it-IT')) : 'mai'}</td>
        <td><div class="azioni-riga"><button class="btn btn--bordo btn--piccolo" type="button" data-sk="${u.attivo ? 'disattiva' : 'attiva'}" data-id="${u.id}">${u.attivo ? 'Disattiva' : 'Riattiva'}</button><button class="btn btn--bordo btn--piccolo" type="button" data-sk="nuova-password" data-id="${u.id}">Nuova password</button></div><div data-sk-pw="${u.id}"></div></td></tr>`).join('')
        : '<tr><td class="vuota" colspan="3">Nessuno skipper ancora.</td></tr>';
    } catch (e) { errore(e); }
  }
  const messaggioSkipper = (email: string, password: string) => `Ciao! Ecco il tuo accesso per l'imbarco di Escursioni Maddalena.\nIndirizzo: ${location.origin}/imbarco/ (dal telefono puoi aggiungerlo alla schermata Home)\nEmail: ${email}\nPassword provvisoria: ${password} (al primo accesso ne scegli una tua)`;
  $('[data-skipper]').addEventListener('click', async (ev) => {
    const b = (ev.target as Element).closest<HTMLElement>('[data-sk]');
    if (!b) return;
    try {
      const r = await api('/api/gestione/utenti', { corpo: { azione: b.dataset.sk, id: Number(b.dataset.id) } });
      if (b.dataset.sk === 'nuova-password') { document.querySelector(`[data-sk-pw="${b.dataset.id}"]`)!.innerHTML = `<textarea rows="4" readonly>${h(messaggioSkipper(r.email, r.password))}</textarea>`; return; }
      caricaSkipper();
    } catch (e) { errore(e); }
  });
  $('[data-modulo-skipper]').addEventListener('submit', async (ev) => {
    ev.preventDefault(); pulisciErrore();
    const f = ev.target as HTMLFormElement;
    try {
      const r = await api('/api/gestione/utenti', { corpo: { azione: 'crea', nome: f.nome.value, email: f.email.value } });
      $('[data-esito-skipper]').innerHTML = `<div class="messaggio-ok">Accesso creato. Manda questi dati allo skipper (la password non sarà più visibile):</div><textarea rows="4" readonly>${h(messaggioSkipper(r.email, r.password))}</textarea>`;
      f.reset(); caricaSkipper();
    } catch (e) { errore(e); }
  });
  $('[data-automatico]').addEventListener('click', async () => {
    const box = $('[data-esito-automatico]');
    box.textContent = 'Controllo…';
    try {
      const r = await api('/api/automatico', { corpo: {} });
      box.textContent = !r.email ? 'Le email non sono ancora attive (manca il collegamento a Resend): per ora le avvisi le mandi tu.'
        : `Fatto: ${r.promemoria} promemoria, ${r.grazie} ringraziamenti, ${r.avvisiMaltempo} avvisi di maltempo, ${r.listaAttesa} avvisi della lista d'attesa.`;
    } catch (e) { box.textContent = (e as Error).message; }
  });


  avvio();
</script>
