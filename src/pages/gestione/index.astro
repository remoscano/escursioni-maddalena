---
// Gestione interna: uscite del giorno, prenotazioni dalle altre piattaforme, maltempo, strutture partner, provvigioni.
import Base from '../../layouts/Base.astro';
import { escursioni } from '../../data/escursioni.js';
import { offerte, regole } from '../../data/prenotazioni.js';
import '../../styles/area.css';
const titoli = Object.fromEntries(escursioni.filter((e) => offerte[e.slug]).map((e) => [e.slug, e.titolo]));
---
<Base titolo="Gestione prenotazioni" descrizione="Area riservata." nascosta senzaBarra>
  <Fragment slot="head">
    <link rel="manifest" href="/gestione/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/img/app-180.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Gestione" />
  </Fragment>
  <section class="area">
    <div class="contenitore">
      <script type="application/json" data-titoli set:html={JSON.stringify(titoli)} />
      <div data-schermo="carico"><p class="testo-2">Un momento…</p></div>

      <div data-schermo="accesso" hidden>
        <div class="area-scheda accesso">
          <p class="occhiello">Area riservata</p>
          <h1 style="font-weight:800;font-size:36px;line-height:1.1">Gestione prenotazioni</h1>
          <form data-modulo-accesso class="pila" style="gap:14px" novalidate>
            <div class="campo"><label for="acc-email">Email</label><input id="acc-email" type="email" autocomplete="username" required /></div>
            <div class="campo"><label for="acc-pw">Password</label><input id="acc-pw" type="password" autocomplete="current-password" required /></div>
            <p class="avviso" data-errore-accesso hidden></p>
            <button class="btn btn--wa btn--grande btn--pieno" type="submit">Entra</button>
          </form>
        </div>
      </div>

      <div data-schermo="password" hidden>
        <div class="area-scheda accesso">
          <h1 style="font-weight:800;font-size:32px;line-height:1.1">Scegli la tua password</h1>
          <p class="testo-2">Al primo accesso sostituisci la password provvisoria con una tua (almeno 10 caratteri).</p>
          <form data-modulo-password class="pila" style="gap:14px" novalidate>
            <div class="campo"><label for="pw-att">Password attuale</label><input id="pw-att" type="password" autocomplete="current-password" required /></div>
            <div class="campo"><label for="pw-nuova">Nuova password</label><input id="pw-nuova" type="password" autocomplete="new-password" minlength="10" required /></div>
            <p class="avviso" data-errore-password hidden></p>
            <button class="btn btn--wa btn--grande btn--pieno" type="submit">Salva la password</button>
          </form>
        </div>
      </div>

      <div data-schermo="area" hidden>
        <div class="area-testa">
          <div><p class="occhiello">Gestione</p><h1>Prenotazioni</h1></div>
          <button class="btn btn--bordo" type="button" data-esci>Esci</button>
        </div>
        <div class="schede-area" role="tablist" aria-label="Sezioni">
          <button role="tab" type="button" data-scheda="giorno" aria-selected="true">Giornata</button>
          <button role="tab" type="button" data-scheda="nuova" aria-selected="false">Inserisci prenotazione</button>
          <button role="tab" type="button" data-scheda="elenco" aria-selected="false">Prenotazioni</button>
          <button role="tab" type="button" data-scheda="attesa" aria-selected="false">Lista d'attesa</button>
          <button role="tab" type="button" data-scheda="statistiche" aria-selected="false">Statistiche</button>
          <button role="tab" type="button" data-scheda="spese" aria-selected="false">Spese di bordo</button>
          <button role="tab" type="button" data-scheda="offerte" aria-selected="false">Offerte</button>
          <button role="tab" type="button" data-scheda="volantini" aria-selected="false">Volantini</button>
          <button role="tab" type="button" data-scheda="strutture" aria-selected="false">Strutture</button>
          <button role="tab" type="button" data-scheda="provvigioni" aria-selected="false">Provvigioni</button>
          <button role="tab" type="button" data-scheda="account" aria-selected="false">Account</button>
        </div>
        <p class="avviso" data-errore role="alert" hidden></p>

        <!-- Giornata -->
        <div role="tabpanel" data-pannello="giorno">
          <div class="area-scheda non-stampare">
            <div class="riga-campi">
              <div class="campo"><label for="g-data">Giorno</label><input id="g-data" type="date" /></div>
              <div class="azioni-riga">
                <button class="btn btn--bordo btn--piccolo" type="button" data-giorno="-1">← Giorno prima</button>
                <button class="btn btn--bordo btn--piccolo" type="button" data-giorno="1">Giorno dopo →</button>
                <button class="btn btn--bordo btn--piccolo" type="button" onclick="window.print()">Stampa</button>
              </div>
            </div>
          </div>
          <div data-giornata class="pila" style="gap:16px;margin-top:20px"></div>
        </div>

        <!-- Inserisci prenotazione -->
        <div role="tabpanel" data-pannello="nuova" hidden>
          <form class="area-scheda" data-modulo-nuova novalidate>
            <h2>Prenotazione da un'altra piattaforma, dal telefono o al molo</h2>
            <p class="testo-2">Inseriscila qui appena arriva: così i posti si aggiornano anche sul sito e non si rischiano doppie prenotazioni.</p>
            <div class="riga-campi">
              <div class="campo"><label for="n-canale">Da dove arriva</label><select id="n-canale" name="canale" required></select></div>
              <div class="campo" data-campo-struttura hidden><label for="n-struttura">Struttura</label><select id="n-struttura" name="partnerId"></select></div>
              <div class="campo"><label for="n-rif">Codice della piattaforma</label><input id="n-rif" name="rifEsterno" maxlength="80" /></div>
            </div>
            <div class="riga-campi">
              <div class="campo"><label for="n-esc">Escursione</label><select id="n-esc" name="escursione" required></select></div>
              <div class="campo"><label for="n-data">Data</label><input id="n-data" name="data" type="date" required /></div>
              <div class="campo"><label for="n-turno">Orario</label><select id="n-turno" name="turno" required></select></div>
            </div>
            <p class="testo-2" data-disponibilita aria-live="polite"></p>
            <div class="riga-campi">
              <div class="campo"><label for="n-adulti">Adulti</label><input id="n-adulti" name="adulti" type="number" min="1" max="20" value="2" required /></div>
              <div class="campo"><label for="n-bambini">Bambini 0–10</label><input id="n-bambini" name="bambini" type="number" min="0" max="20" value="0" /></div>
              <div class="campo"><label for="n-imbarco">Imbarco</label><select id="n-imbarco" name="imbarco"><option value="maddalena">La Maddalena</option><option value="palau">Palau</option><option value="cannigione">Cannigione</option></select></div>
            </div>
            <div class="riga-campi">
              <div class="campo"><label for="n-nome">Nome e cognome</label><input id="n-nome" name="nome" maxlength="100" required /></div>
              <div class="campo"><label for="n-tel">Telefono</label><input id="n-tel" name="telefono" type="tel" maxlength="30" /></div>
              <div class="campo"><label for="n-email">Email</label><input id="n-email" name="email" type="email" maxlength="160" /></div>
            </div>
            <div class="riga-campi">
              <div class="campo"><label for="n-importo">Importo (€)</label><input id="n-importo" name="importo" inputmode="decimal" /></div>
              <label class="spunta-riga"><input type="checkbox" name="pagato" /><span>Già pagato (sulla piattaforma o al molo)</span></label>
            </div>
            <div class="riga-campi">
              <label class="spunta-riga"><input type="checkbox" name="link" /><span>Il cliente paga online: crea il link di pagamento (i posti restano tenuti)</span></label>
              <div class="campo" data-campo-ore hidden><label for="n-ore">Il link vale per</label><select id="n-ore" name="ore">{regole.orePerPagareLink.map((o) => <option value={o} selected={o === 24}>{o} ore</option>)}</select></div>
            </div>
            <div data-esito-link></div>
            <div class="campo"><label for="n-note">Note</label><textarea id="n-note" name="note" rows="2" maxlength="1000"></textarea></div>
            <p class="messaggio-ok" data-esito-nuova hidden></p>
            <button class="btn btn--wa btn--grande" type="submit">Inserisci prenotazione</button>
          </form>
        </div>

        <!-- Elenco -->
        <div role="tabpanel" data-pannello="elenco" hidden>
          <form class="area-scheda non-stampare" data-filtri>
            <div class="riga-campi">
              <div class="campo"><label for="f-q">Cerca</label><input id="f-q" name="q" placeholder="Codice, nome, telefono, email" /></div>
              <div class="campo"><label for="f-stato">Stato</label><select id="f-stato" name="stato"><option value="">Tutte</option><option value="confermata">Confermate</option><option value="in_attesa">Aspettano il pagamento (link)</option><option value="da_verificare">Da verificare</option><option value="scelta">Maltempo: aspettano la scelta</option><option value="rimborsi">Rimborsi da fare</option><option value="annullata">Annullate</option></select></div>
              <div class="campo"><label for="f-dal">Dal</label><input id="f-dal" name="dal" type="date" /></div>
              <div class="campo"><label for="f-al">Al</label><input id="f-al" name="al" type="date" /></div>
            </div>
            <div class="azioni-riga"><button class="btn btn--scuro btn--piccolo" type="submit">Cerca</button><button class="btn btn--bordo btn--piccolo" type="button" data-csv="elenco">Scarica CSV</button></div>
          </form>
          <div class="tabella-box" style="margin-top:20px"><table class="tabella" data-tabella-elenco>
            <thead><tr><th>Data</th><th>Codice</th><th>Escursione</th><th>Cliente</th><th class="num">Persone</th><th class="num">Totale</th><th>Canale</th><th>Stato</th><th></th></tr></thead>
            <tbody data-elenco></tbody>
          </table></div>
        </div>


        <!-- Lista d'attesa -->
        <div role="tabpanel" data-pannello="attesa" hidden>
          <div class="area-scheda">
            <h2>Lista d'attesa</h2>
            <p class="testo-2">Chi ha chiesto di essere avvisato se si libera un posto. Con le email attive l'avviso parte da solo; altrimenti scrivi tu su WhatsApp quando la riga diventa verde.</p>
            <div class="tabella-box"><table class="tabella">
              <thead><tr><th>Data</th><th>Escursione</th><th class="num">Persone</th><th>Cliente</th><th>Stato</th><th></th></tr></thead>
              <tbody data-attesa></tbody>
            </table></div>
          </div>
        </div>

        <!-- Statistiche -->
        <div role="tabpanel" data-pannello="statistiche" hidden>
          <form class="area-scheda non-stampare" data-filtri-stat>
            <div class="riga-campi">
              <div class="campo"><label for="st-periodo">Periodo</label><select id="st-periodo" name="periodo"><option value="stagione" selected>Stagione {regole.stagione.dal.slice(0, 4)}</option><option value="anno">Quest'anno</option><option value="mese">Questo mese</option><option value="scorso">Mese scorso</option><option value="altro">Scegli le date</option></select></div>
              <div class="campo"><label for="st-dal">Dal</label><input id="st-dal" name="dal" type="date" /></div>
              <div class="campo"><label for="st-al">Al</label><input id="st-al" name="al" type="date" /></div>
              <div class="campo"><label for="st-base">Le date sono</label><select id="st-base" name="base"><option value="escursione">dell'escursione</option><option value="prenotazione">della prenotazione</option></select></div>
            </div>
            <div class="azioni-riga"><button class="btn btn--scuro btn--piccolo" type="submit">Aggiorna</button><button class="btn btn--bordo btn--piccolo" type="button" data-excel>Scarica Excel per il commercialista</button><button class="btn btn--bordo btn--piccolo" type="button" onclick="window.print()">Stampa</button></div>
          </form>
          <div data-statistiche style="margin-top:20px"></div>
        </div>


        <!-- Spese di bordo -->
        <div role="tabpanel" data-pannello="spese" hidden>
          <form class="area-scheda non-stampare" data-filtri-spese>
            <p class="testo-2">Le scrivono gli skipper dalla loro app (/imbarco/, scheda Spese) dopo ogni giornata: carburante con litri ed euro, bevande, cibo, altro.</p>
            <div class="riga-campi">
              <div class="campo"><label for="sp-periodo">Periodo</label><select id="sp-periodo"><option value="mese">Questo mese</option><option value="scorso">Mese scorso</option><option value="stagione">Stagione {regole.stagione.dal.slice(0, 4)}</option><option value="anno">Quest'anno</option><option value="altro">Scegli le date</option></select></div>
              <div class="campo"><label for="sp-dal">Dal</label><input id="sp-dal" name="dal" type="date" /></div>
              <div class="campo"><label for="sp-al">Al</label><input id="sp-al" name="al" type="date" /></div>
            </div>
            <div class="azioni-riga"><button class="btn btn--scuro btn--piccolo" type="submit">Aggiorna</button><button class="btn btn--bordo btn--piccolo" type="button" data-excel-spese>Scarica Excel delle spese</button></div>
          </form>
          <div data-spese style="margin-top:20px"></div>
        </div>

        <!-- Offerte: promozioni, codici sconto, buoni regalo, extra -->
        <div role="tabpanel" data-pannello="offerte" hidden>
          <div class="area-scheda">
            <h2>Promozioni automatiche</h2>
            <p class="testo-2">Si applicano da sole sul sito. Se valgono più promozioni, il cliente ha la migliore (non si sommano, e un codice sconto vale solo se conviene di più). Il weekend è un aumento di prezzo il sabato e la domenica.</p>
            <form class="riga-campi" data-modulo-regola novalidate>
              <div class="campo"><label for="r-tipo">Tipo</label><select id="r-tipo" name="regola"><option value="anticipo">Prenotazione anticipata</option><option value="ultimo-minuto">Ultimo minuto</option><option value="gruppo">Sconto gruppo</option><option value="weekend">Weekend (aumento)</option></select></div>
              <div class="campo" data-soglia><label for="r-soglia" data-etichetta-soglia>Almeno quanti giorni prima</label><input id="r-soglia" name="soglia" type="number" min="1" max="400" /></div>
              <div class="campo"><label for="r-pct" data-etichetta-pct>Sconto %</label><input id="r-pct" name="percentuale" type="number" min="1" max="90" step="0.5" required /></div>
              <div class="campo"><label for="r-nome">Nome (facoltativo)</label><input id="r-nome" name="nome" maxlength="60" placeholder="Es. Prenota prima" /></div>
              <div class="campo"><label for="r-esc">Escursione</label><select id="r-esc" name="escursioni" data-escursioni-tutte></select></div>
              <div class="campo"><label for="r-dal">Per uscite dal (facoltativo)</label><input id="r-dal" name="dal" type="date" /></div>
              <div class="campo"><label for="r-al">al</label><input id="r-al" name="al" type="date" /></div>
              <button class="btn btn--wa btn--piccolo" type="submit">Aggiungi</button>
            </form>
            <div class="tabella-box"><table class="tabella"><thead><tr><th>Promozione</th><th>Regola</th><th>Vale per</th><th>Stato</th><th></th></tr></thead><tbody data-regole></tbody></table></div>
          </div>

          <div class="area-scheda">
            <h2>Codici sconto</h2>
            <p class="testo-2">Il cliente scrive il codice nel riepilogo, prima di pagare.</p>
            <form class="riga-campi" data-modulo-codice novalidate>
              <div class="campo"><label for="c-codice">Codice</label><input id="c-codice" name="codice" maxlength="20" placeholder="ESTATE10" style="text-transform:uppercase" required /></div>
              <div class="campo"><label for="c-tipo">Sconto</label><select id="c-tipo" name="sconto"><option value="percentuale">In percentuale</option><option value="importo">In euro</option></select></div>
              <div class="campo"><label for="c-valore">Quanto (% o €)</label><input id="c-valore" name="valore" type="number" min="1" step="0.5" required /></div>
              <div class="campo"><label for="c-usi">Quante volte si può usare</label><input id="c-usi" name="usiMax" type="number" min="1" placeholder="senza limite" /></div>
              <div class="campo"><label for="c-esc">Escursione</label><select id="c-esc" name="escursioni" data-escursioni-tutte></select></div>
              <div class="campo"><label for="c-dal">Per uscite dal (facoltativo)</label><input id="c-dal" name="dal" type="date" /></div>
              <div class="campo"><label for="c-al">al</label><input id="c-al" name="al" type="date" /></div>
              <div class="campo"><label for="c-note">Note</label><input id="c-note" name="note" maxlength="200" placeholder="Es. per l'hotel X" /></div>
              <button class="btn btn--wa btn--piccolo" type="submit">Crea codice</button>
            </form>
            <div class="tabella-box"><table class="tabella"><thead><tr><th>Codice</th><th>Sconto</th><th>Vale per</th><th class="num">Usato</th><th class="num">Scontato</th><th>Stato</th><th></th></tr></thead><tbody data-codici></tbody></table></div>
          </div>

          <div class="area-scheda">
            <h2>Buoni regalo</h2>
            <p class="testo-2">Si comprano online su <a href="/buono-regalo/" target="_blank">/buono-regalo/</a>. Da qui puoi farne uno a mano (pagato in contanti, omaggio o credito al posto di un rimborso).</p>
            <form class="riga-campi" data-modulo-buono novalidate>
              <div class="campo"><label for="b-valore">Importo (€)</label><input id="b-valore" name="valore" type="number" min="1" step="1" required /></div>
              <div class="campo"><label for="b-acq">Chi lo compra</label><input id="b-acq" name="acquirente" maxlength="100" /></div>
              <div class="campo"><label for="b-dest">Per chi</label><input id="b-dest" name="destinatario" maxlength="100" /></div>
              <div class="campo"><label for="b-al">Scade il</label><input id="b-al" name="al" type="date" /></div>
              <label class="spunta-riga"><input type="checkbox" name="pagato" /><span>Pagato (contanti o POS)</span></label>
              <button class="btn btn--wa btn--piccolo" type="submit">Crea buono</button>
            </form>
            <div data-esito-buono></div>
            <div class="tabella-box"><table class="tabella"><thead><tr><th>Codice</th><th>Per</th><th class="num">Valore</th><th class="num">Resta</th><th>Scade</th><th>Stato</th><th></th></tr></thead><tbody data-buoni></tbody></table></div>
          </div>

          <div class="area-scheda">
            <h2>Extra a pagamento</h2>
            <p class="testo-2">Il cliente li aggiunge prima di pagare. Se metti un massimo al giorno, quando finiscono non si vedono più per quella data.</p>
            <form class="riga-campi" data-modulo-extra novalidate>
              <div class="campo"><label for="x-nome">Nome</label><input id="x-nome" name="nome" maxlength="60" placeholder="Es. Foto ricordo" required /></div>
              <div class="campo"><label for="x-prezzo">Prezzo (€)</label><input id="x-prezzo" name="prezzo" type="number" min="0.5" step="0.5" required /></div>
              <div class="campo"><label for="x-modo">Il prezzo è</label><select id="x-modo" name="modo"><option value="prenotazione">Uno per prenotazione</option><option value="persona">A persona</option></select></div>
              <div class="campo"><label for="x-max">Massimo al giorno</label><input id="x-max" name="maxGiorno" type="number" min="1" placeholder="senza limite" /></div>
              <div class="campo"><label for="x-esc">Escursione</label><select id="x-esc" name="escursioni" data-escursioni-tutte></select></div>
              <div class="campo"><label for="x-desc">Descrizione breve</label><input id="x-desc" name="descrizione" maxlength="200" /></div>
              <button class="btn btn--wa btn--piccolo" type="submit">Aggiungi extra</button>
            </form>
            <div class="tabella-box"><table class="tabella"><thead><tr><th>Extra</th><th class="num">Prezzo</th><th>Massimo al giorno</th><th class="num">Venduti</th><th>Stato</th><th></th></tr></thead><tbody data-extra-gestione></tbody></table></div>
          </div>
        </div>

        <!-- Volantini -->
        <div role="tabpanel" data-pannello="volantini" hidden>
          <div class="area-scheda">
            <h2>Volantini e locandine</h2>
            <p class="testo-2">Ogni volantino ha il suo codice QR: chi lo inquadra arriva alla prenotazione, e qui vedi quante visite e quante prenotazioni porta. Si conta solo il numero, nessun dato personale.</p>
            <form class="riga-campi" data-modulo-volantino novalidate>
              <div class="campo"><label for="v-nome">Dove lo metti</label><input id="v-nome" name="nome" maxlength="80" placeholder="Es. Locandina bar del porto di Palau" required /></div>
              <div class="campo"><label for="v-codice">Codice (facoltativo)</label><input id="v-codice" name="codice" maxlength="20" placeholder="Es. BARPALAU" style="text-transform:uppercase" /></div>
              <button class="btn btn--wa btn--piccolo" type="submit">Crea volantino</button>
            </form>
            <div class="tabella-box"><table class="tabella"><thead><tr><th>Volantino</th><th class="num">Visite</th><th class="num">Prenotazioni</th><th class="num">Incasso</th><th>QR</th></tr></thead><tbody data-volantini></tbody></table></div>
          </div>
        </div>

        <!-- Strutture -->
        <div role="tabpanel" data-pannello="strutture" hidden>
          <div class="area-scheda">
            <h2>Strutture partner</h2>
            <div class="tabella-box"><table class="tabella">
              <thead><tr><th>Struttura</th><th>Contatti</th><th class="num">%</th><th class="num">Venduto</th><th class="num">Maturato</th><th class="num">Pagato</th><th class="num">Da pagare</th><th>Azioni</th></tr></thead>
              <tbody data-strutture></tbody>
            </table></div>
          </div>
          <form class="area-scheda" data-modulo-struttura novalidate>
            <h2>Nuova struttura</h2>
            <div class="riga-campi">
              <div class="campo"><label for="s-nome">Nome della struttura</label><input id="s-nome" name="nome" maxlength="100" required /></div>
              <div class="campo"><label for="s-email">Email (per l'accesso)</label><input id="s-email" name="email" type="email" maxlength="160" required /></div>
              <div class="campo"><label for="s-tel">Telefono</label><input id="s-tel" name="telefono" type="tel" maxlength="30" /></div>
              <div class="campo"><label for="s-ref">Referente</label><input id="s-ref" name="referente" maxlength="100" /></div>
              <div class="campo"><label for="s-pct">Provvigione %</label><input id="s-pct" name="provvigione" type="number" min="0" max="50" step="0.5" value={regole.provvigioneStrutture} /></div>
            </div>
            <div data-esito-struttura></div>
            <button class="btn btn--wa btn--grande" type="submit">Crea struttura e accesso</button>
          </form>
        </div>

        <!-- Provvigioni -->
        <div role="tabpanel" data-pannello="provvigioni" hidden>
          <div class="area-scheda">
            <h2>Provvigioni per quindicina</h2>
            <p class="testo-2">Contano le escursioni confermate fatte nella quindicina. Quando hai fatto il bonifico, segna la quindicina come pagata: la struttura lo vede nella sua area.</p>
            <div class="riga-campi">
              <div class="campo"><label for="p-periodo">Quindicina</label><select id="p-periodo"></select></div>
              <div class="azioni-riga"><button class="btn btn--bordo btn--piccolo" type="button" data-csv="provvigioni">Scarica CSV</button></div>
            </div>
            <div class="tabella-box"><table class="tabella" data-tabella-provvigioni>
              <thead><tr><th>Struttura</th><th class="num">Prenotazioni</th><th class="num">Venduto</th><th class="num">Provvigione</th><th>Stato</th></tr></thead>
              <tbody data-provvigioni></tbody>
            </table></div>
          </div>
        </div>

        <!-- Account -->
        <div role="tabpanel" data-pannello="account" hidden>
          <form class="area-scheda accesso" data-modulo-password2 novalidate style="margin:0">
            <h2>Cambia password</h2>
            <div class="campo"><label for="pw2-att">Password attuale</label><input id="pw2-att" type="password" autocomplete="current-password" required /></div>
            <div class="campo"><label for="pw2-nuova">Nuova password</label><input id="pw2-nuova" type="password" autocomplete="new-password" minlength="10" required /></div>
            <p class="messaggio-ok" data-ok-password hidden>Password cambiata.</p>
            <button class="btn btn--wa" type="submit">Salva</button>
          </form>
          <div class="area-scheda" style="margin-top:20px">
            <h2>Accessi skipper</h2>
            <p class="testo-2">Lo skipper entra da <strong data-indirizzo-imbarco></strong>: vede solo le uscite di oggi, segna chi sale a bordo (anche inquadrando il QR del biglietto) e scrive le spese di bordo di ogni giornata. Dal telefono si installa come un'app: nel browser, "Aggiungi a schermata Home".</p>
            <form class="riga-campi" data-modulo-skipper novalidate>
              <div class="campo"><label for="sk-nome">Nome</label><input id="sk-nome" name="nome" maxlength="100" required /></div>
              <div class="campo"><label for="sk-email">Email (per l'accesso)</label><input id="sk-email" name="email" type="email" maxlength="160" required /></div>
              <button class="btn btn--wa btn--piccolo" type="submit">Crea accesso</button>
            </form>
            <div data-esito-skipper></div>
            <div class="tabella-box"><table class="tabella"><thead><tr><th>Skipper</th><th>Ultimo accesso</th><th></th></tr></thead><tbody data-skipper></tbody></table></div>
          </div>
          <div class="area-scheda" style="margin-top:20px">
            <h2>Email automatiche</h2>
            <p class="testo-2">Ogni ora partono da sole: promemoria il giorno prima (dalle {regole.promemoria.ora}), grazie con il link per la recensione dopo l'uscita, avvisi di maltempo, lista d'attesa. Qui puoi farle partire subito.</p>
            <div class="azioni-riga"><button class="btn btn--bordo btn--piccolo" type="button" data-automatico>Controlla e manda adesso</button></div>
            <p class="testo-2" data-esito-automatico aria-live="polite"></p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <dialog class="dialogo" data-dialogo aria-labelledby="dlg-titolo">
    <div class="dialogo__testa"><h2 id="dlg-titolo" data-dlg-titolo></h2><button type="button" class="btn btn--bordo btn--piccolo" data-dlg-chiudi>Chiudi</button></div>
    <div data-dlg-corpo></div>
  </dialog>
</Base>

<script>
  import { offerte, canaliEsterni, calcolaPrenotazione, NOMI_REGOLE, regole } from '../../data/prenotazioni.js';
  import { api, ErroreApi, h, euro, dataBreve, dataLunga, oggiRoma, aggiungiGiorni, persone } from '../../scripts/comune';
  import { svgQr, pngQr } from '../../scripts/qr';
  import { scaricaXlsx } from '../../scripts/xlsx';

  // Installabile sul telefono come un'app.
  if ('serviceWorker' in navigator) navigator.serviceWorker.register('/gestione/sw.js', { scope: '/gestione/' }).catch(() => {});

  const titoli: Record<string, string> = JSON.parse(document.querySelector('[data-titoli]')!.textContent || '{}');
  const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const schermi = document.querySelectorAll<HTMLElement>('[data-schermo]');
  const mostra = (nome: string) => schermi.forEach((s) => (s.hidden = s.dataset.schermo !== nome));
  const STATI: Record<string, string> = { confermata: 'Confermata', annullata: 'Annullata', da_verificare: 'Da verificare', in_attesa: 'In pagamento' };
  const BLOCCHI: Record<string, string> = { mattina: 'Mattina', pomeriggio: 'Pomeriggio', sera: 'Sera' };
  let strutture: any[] = [];

  function errore(e: unknown) {
    const box = $('[data-errore]');
    box.textContent = e instanceof Error ? e.message : String(e);
    box.hidden = false;
    box.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
  const pulisciErrore = () => { $('[data-errore]').hidden = true; };
  const wa = (tel: string, testo = '') => {
    const n = String(tel || '').replace(/[^\d+]/g, '').replace(/^\+/, '').replace(/^00/, '');
    const numero = n.length <= 10 ? `39${n}` : n;
    return n ? `<a href="https://wa.me/${numero}${testo ? `?text=${encodeURIComponent(testo)}` : ''}" target="_blank" rel="noopener">WhatsApp</a>` : '';
  };

  // ---------- Avvio e accesso ----------
  async function avvio() {
    try {
      const u = await api('/api/accesso');
      if (u.ruolo !== 'gestione') { mostra('accesso'); $('[data-errore-accesso]').textContent = u.ruolo === 'skipper' ? 'Il tuo accesso è per l\'imbarco: vai su /imbarco/.' : 'Questo accesso è di una struttura: la sua area è su /partner/.'; $('[data-errore-accesso]').hidden = false; return; }
      if (u.deveCambiare) { mostra('password'); return; }
      entra();
    } catch (e) {
      mostra('accesso');
      if (!(e instanceof ErroreApi && e.stato === 401)) { $('[data-errore-accesso]').textContent = (e as Error).message; $('[data-errore-accesso]').hidden = false; }
    }
  }

  function entra() {
    mostra('area');
    const oggi = oggiRoma();
    const inizio = oggi < '2027-05-01' ? '2027-05-01' : oggi;
    $<HTMLInputElement>('#g-data').value = inizio;
    $<HTMLInputElement>('#n-data').value = inizio;
    preparaNuova();
    caricaGiorno();
  }

  $('[data-modulo-accesso]').addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const err = $('[data-errore-accesso]');
    err.hidden = true;
    try {
      const u = await api('/api/accesso', { corpo: { email: $<HTMLInputElement>('#acc-email').value, password: $<HTMLInputElement>('#acc-pw').value } });
      $<HTMLInputElement>('#acc-pw').value = '';
      if (u.ruolo !== 'gestione') { err.textContent = u.ruolo === 'skipper' ? 'Il tuo accesso è per l\'imbarco: vai su /imbarco/.' : 'Questo accesso è di una struttura: la sua area è su /partner/.'; err.hidden = false; return; }
      if (u.deveCambiare) mostra('password'); else entra();
    } catch (e) { err.textContent = (e as Error).message; err.hidden = false; }
  });

  async function cambiaPassword(att: string, nuova: string) {
    await api('/api/accesso/password', { corpo: { attuale: $<HTMLInputElement>(att).value, nuova: $<HTMLInputElement>(nuova).value } });
    $<HTMLInputElement>(att).value = ''; $<HTMLInputElement>(nuova).value = '';
  }
  $('[data-modulo-password]').addEventListener('submit', async (ev) => {
    ev.preventDefault();
    try { await cambiaPassword('#pw-att', '#pw-nuova'); entra(); }
    catch (e) { $('[data-errore-password]').textContent = (e as Error).message; $('[data-errore-password]').hidden = false; }
  });
  $('[data-modulo-password2]').addEventListener('submit', async (ev) => {
    ev.preventDefault(); pulisciErrore();
    try { await cambiaPassword('#pw2-att', '#pw2-nuova'); $('[data-ok-password]').hidden = false; } catch (e) { errore(e); }
  });
  $('[data-esci]').addEventListener('click', async () => { await api('/api/accesso', { metodo: 'DELETE', corpo: {} }).catch(() => {}); location.reload(); });

  // ---------- Schede ----------
  document.querySelectorAll<HTMLButtonElement>('[data-scheda]').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll<HTMLButtonElement>('[data-scheda]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
    document.querySelectorAll<HTMLElement>('[data-pannello]').forEach((p) => (p.hidden = p.dataset.pannello !== b.dataset.scheda));
    pulisciErrore();
    ({ giorno: caricaGiorno, nuova: () => {}, elenco: caricaElenco, strutture: caricaStrutture, provvigioni: caricaProvvigioni, account: caricaSkipper,
       attesa: caricaAttesa, statistiche: caricaStatistiche, spese: caricaSpeseGestione, offerte: caricaOfferte, volantini: caricaVolantini } as Record<string, () => void>)[b.dataset.scheda!]();
  }));

  // ---------- Giornata ----------
  async function caricaGiorno() {
    const data = $<HTMLInputElement>('#g-data').value;
    const box = $('[data-giornata]');
    if (!data) return;
    box.innerHTML = '<p class="testo-2">Carico…</p>';
    try {
      const d = await api(`/api/gestione/giorno?data=${data}`);
      box.innerHTML = `<h2 style="font-size:24px;font-weight:800;text-transform:capitalize">${h(dataLunga(data))}</h2>` + d.gommoni.map((g: any) => `
        <div class="gommone-giorno">
          <div class="uscita__testa"><h3 style="font-size:20px;font-weight:800">${h(g.nome)} <span class="testo-2" style="font-weight:500;font-size:15px">· ${g.posti} posti · ${g.tipo === 'esclusiva' ? 'esclusiva' : 'gruppo'}</span></h3></div>
          ${g.chiusure.length ? `<div class="azioni-riga">${g.chiusure.map((c: any) => `<span class="stato stato--attenzione">Chiuso ${h(BLOCCHI[c.blocco])}${c.barca === '*' ? ' (tutti)' : ''}${c.motivo ? ` · ${h(c.motivo)}` : ''}</span><button class="btn btn--bordo btn--piccolo non-stampare" type="button" data-riapri="${c.id}">Riapri</button>`).join('')}</div>` : ''}
          ${g.uscite.length ? g.uscite.map((u: any) => `
            <div class="uscita">
              <div class="uscita__testa">
                <strong>${h(u.escursione)} · ${h(u.turno)}${u.orario ? ` · ${h(u.orario)}` : ''}</strong>
                <span class="stato ${u.confermata ? 'stato--ok' : 'stato--attenzione'}">${u.persone}/${g.posti} prenotati${u.aBordo ? ` · ${u.aBordo} a bordo` : ''}${u.privato ? ' · privato' : ` · ${u.paganti} paganti · ${u.confermata ? 'confermata' : `mancano ${u.minimo - u.paganti} per il minimo`}`}</span>
              </div>
              <div class="tabella-box"><table class="tabella">
                <thead><tr><th>Codice</th><th>Nome</th><th>Contatti</th><th class="num">Persone</th><th>Imbarco</th><th>Canale</th><th>Note</th><th>A bordo</th><th class="non-stampare"></th></tr></thead>
                <tbody>${u.prenotazioni.map((p: any) => { ricorda(p); return `<tr>
                  <td>${h(p.codice)}${p.stato !== 'confermata' ? `<br><span class="stato stato--${h(p.stato)}">${h(STATI[p.stato] || p.stato)}</span>` : ''}</td>
                  <td>${h(p.nome)}</td>
                  <td>${p.telefono ? `<a href="tel:${h(p.telefono)}">${h(p.telefono)}</a><br>${wa(p.telefono)}` : ''}${p.email ? `<br><span class="testo-2">${h(p.email)}</span>` : ''}</td>
                  <td class="num">${h(persone(p.adulti, p.bambini, p.neonati))}</td>
                  <td>${h(p.imbarco)}</td>
                  <td>${h(p.canale)}${p.struttura ? `<br><span class="testo-2">${h(p.struttura)}</span>` : ''}${p.rifEsterno ? `<br><span class="testo-2">${h(p.rifEsterno)}</span>` : ''}<br>${p.daPagare > 0 ? `<span class="stato stato--attenzione">da pagare ${euro(p.daPagare)}</span>` : `<span class="testo-2">pagato ${euro(p.pagato + p.buono)}</span>`}</td>
                  <td>${h(p.note || '')}${p.extra?.length ? `<br><span class="testo-2">Extra: ${h(p.extra.join(', '))}</span>` : ''}${p.dataOriginale && p.dataOriginale !== data ? `<br><span class="testo-2">spostata dal ${h(dataBreve(p.dataOriginale))}</span>` : ''}</td>
                  <td>${p.checkin ? '<span class="stato stato--ok">A bordo</span>' : '—'}</td>
                  <td class="non-stampare"><button class="btn btn--bordo btn--piccolo" type="button" data-gestisci="${p.id}">Gestisci</button></td></tr>`; }).join('')}</tbody>
              </table></div>
              <details class="azione-extra non-stampare">
                <summary>Annulla questa uscita (maltempo)</summary>
                <div class="riga-campi" style="margin-top:8px">
                  <div class="campo"><label>Motivo</label><input data-motivo placeholder="Es. maestrale forte" maxlength="200" /></div>
                  <button class="btn btn--avviso btn--piccolo" type="button" data-annulla-uscita data-barca="${h(g.id)}" data-escursione="${h(u.escursioneSlug)}" data-turno="${h(u.turnoId)}">Annulla l'uscita e chiudi il gommone</button>
                </div>
                <div data-avvisi></div>
              </details>
            </div>`).join('') : '<p class="testo-2">Nessuna uscita prenotata.</p>'}
          <details class="azione-extra non-stampare">
            <summary>Chiudi questo gommone</summary>
            <div class="spunte" style="margin-top:8px">${Object.entries(BLOCCHI).map(([k, v]) => `<label><input type="checkbox" value="${k}" data-blocco />${v}</label>`).join('')}</div>
            <div class="riga-campi">
              <div class="campo"><label>Motivo</label><input data-motivo placeholder="Es. manutenzione" maxlength="200" /></div>
              <button class="btn btn--scuro btn--piccolo" type="button" data-chiudi="${h(g.id)}">Chiudi</button>
            </div>
          </details>
        </div>`).join('') + (d.annullate.length ? `
        <div class="gommone-giorno"><h3 style="font-size:18px;font-weight:800">Annullate</h3>
          <div class="tabella-box"><table class="tabella"><thead><tr><th>Codice</th><th>Nome</th><th>Escursione</th><th>Contatti</th><th>Rimborso</th></tr></thead><tbody>
          ${d.annullate.map((p: any) => { ricorda(p); return `<tr><td>${h(p.codice)}</td><td>${h(p.nome)}</td><td>${h(p.escursione)} · ${h(p.turno)}</td><td>${p.telefono ? `${h(p.telefono)} ${wa(p.telefono)}` : ''}</td>
            <td>${statoRimborso(p)} <button class="btn btn--bordo btn--piccolo non-stampare" type="button" data-gestisci="${p.id}">Gestisci</button></td></tr>`; }).join('')}
          </tbody></table></div></div>` : '');
    } catch (e) { box.innerHTML = ''; errore(e); }
  }

  $<HTMLInputElement>('#g-data').addEventListener('change', caricaGiorno);
  document.querySelectorAll<HTMLButtonElement>('[data-giorno]').forEach((b) => b.addEventListener('click', () => {
    const c = $<HTMLInputElement>('#g-data');
    c.value = aggiungiGiorni(c.value || oggiRoma(), Number(b.dataset.giorno));
    caricaGiorno();
  }));

  $('[data-giornata]').addEventListener('click', async (ev) => {
    const t = ev.target as HTMLElement;
    const data = $<HTMLInputElement>('#g-data').value;
    pulisciErrore();
    try {
      const riapri = t.closest<HTMLElement>('[data-riapri]');
      if (riapri) { await api(`/api/gestione/chiusure?id=${riapri.dataset.riapri}`, { metodo: 'DELETE', corpo: {} }); return caricaGiorno(); }
      const chiudi = t.closest<HTMLElement>('[data-chiudi]');
      if (chiudi) {
        const box = chiudi.closest('details')!;
        const blocchi = [...box.querySelectorAll<HTMLInputElement>('[data-blocco]:checked')].map((x) => x.value);
        await api('/api/gestione/chiusure', { corpo: { azione: 'chiudi', data, barca: chiudi.dataset.chiudi, blocchi, motivo: box.querySelector<HTMLInputElement>('[data-motivo]')!.value } });
        return caricaGiorno();
      }
      const uscita = t.closest<HTMLElement>('[data-annulla-uscita]');
      if (uscita) {
        const box = uscita.closest('details')!;
        const motivo = box.querySelector<HTMLInputElement>('[data-motivo]')!.value;
        uscita.setAttribute('disabled', '');
        const r = await api('/api/gestione/chiusure', { corpo: { azione: 'annulla-uscita', data, barca: uscita.dataset.barca, escursione: uscita.dataset.escursione, turno: uscita.dataset.turno, motivo } });
        await caricaGiorno();
        if (r.annullate.length) {
          const testo = (p: any) => `Ciao ${p.nome}, purtroppo l'uscita del ${dataLunga(data)} è annullata per le condizioni del mare${motivo ? ` (${motivo})` : ''}. Scegli tu: un'altra data o il rimborso completo, da qui: ${p.link}`;
          $('[data-giornata]').insertAdjacentHTML('afterbegin', `<div class="area-scheda"><h3>Clienti dell'uscita annullata</h3><p class="testo-2">Ognuno sceglie da solo tra un'altra data e il rimborso completo, dal suo link. Chi ha l'email l'ha già ricevuto; agli altri mandalo su WhatsApp.</p><ul>${r.annullate.map((p: any) => `<li>${h(p.nome)} (${h(p.codice)}) ${p.emailInviata ? '<span class="stato stato--ok">email mandata</span>' : ''} ${p.telefono ? wa(p.telefono, testo(p)) : ''} <button type="button" class="btn btn--bordo btn--piccolo" data-copia="${h(p.link)}">Copia il link</button></li>`).join('')}</ul></div>`);
        }
        return;
      }
      const gestisci = t.closest<HTMLElement>('[data-gestisci]');
      if (gestisci) { apriAzioni(Number(gestisci.dataset.gestisci), caricaGiorno); return; }
    } catch (e) { errore(e); }
  });

  // ---------- Inserisci prenotazione ----------
  function preparaNuova() {
    $<HTMLSelectElement>('#n-canale').innerHTML = [...canaliEsterni, 'Struttura partner'].map((c) => `<option>${h(c)}</option>`).join('');
    $<HTMLSelectElement>('#n-esc').innerHTML = Object.entries(titoli).map(([slug, t]) => `<option value="${h(slug)}">${h(t)}</option>`).join('');
    aggiornaTurni();
  }
  function aggiornaTurni() {
    const slug = $<HTMLSelectElement>('#n-esc').value;
    $<HTMLSelectElement>('#n-turno').innerHTML = offerte[slug].turni.map((t: any) => `<option value="${h(t.id)}">${h(t.nome)}${t.orari ? ' · orario secondo il mese' : t.orario ? ` · ${h(t.orario)}` : ''}</option>`).join('');
    controllaPosti();
  }
  let richiestaPosti = 0;
  async function controllaPosti() {
    const mia = ++richiestaPosti;
    const slug = $<HTMLSelectElement>('#n-esc').value, data = $<HTMLInputElement>('#n-data').value, turno = $<HTMLSelectElement>('#n-turno').value, imbarco = $<HTMLSelectElement>('#n-imbarco').value;
    const box = $('[data-disponibilita]');
    const f = $<HTMLFormElement>('[data-modulo-nuova]');
    const calcolo: any = calcolaPrenotazione(slug, turno, data, { adulti: Number(f.adulti.value), bambini: Number(f.bambini.value) });
    $<HTMLInputElement>('#n-importo').placeholder = calcolo.errore ? '' : `listino: ${calcolo.totale}`;
    if (!data) { box.textContent = ''; return; }
    if (!offerte[slug].imbarchi.includes(imbarco)) { box.textContent = 'Da questo imbarco l\'escursione non parte.'; return; }
    try {
      const d = await api(`/api/disponibilita?escursione=${slug}&mese=${data.slice(0, 7)}&gestione=1&imbarco=${imbarco}`);
      if (mia !== richiestaPosti) return; // è arrivata una risposta vecchia: si ignora
      const g = d.giorni[data];
      const t = g?.turni?.find((x: any) => x.id === turno);
      box.textContent = !g || g.stato === 'chiuso' ? 'Data fuori stagione o nel passato.'
        : !t?.disponibile ? 'Nessun posto libero per questo orario.'
        : offerte[slug].tipo === 'esclusiva' ? `Gommone libero (fino a ${t.max} persone).` : `Posti liberi: ${t.max}${t.confermata ? ' · uscita già confermata' : ` · mancano ${t.mancano} persone al minimo`}.`;
    } catch (e) { box.textContent = (e as Error).message; }
  }
  $('#n-esc').addEventListener('change', aggiornaTurni);
  ['#n-data', '#n-turno', '#n-adulti', '#n-bambini', '#n-imbarco'].forEach((s) => $(s).addEventListener('change', controllaPosti));
  $('[data-modulo-nuova]').addEventListener('change', (ev) => {
    const f = ev.currentTarget as HTMLFormElement;
    if ((ev.target as HTMLInputElement).name === 'link') { $('[data-campo-ore]').hidden = !f.link.checked; if (f.link.checked) f.pagato.checked = false; }
    if ((ev.target as HTMLInputElement).name === 'pagato' && f.pagato.checked) { f.link.checked = false; $('[data-campo-ore]').hidden = true; }
  });
  $('#n-canale').addEventListener('change', async () => {
    const struttura = $<HTMLSelectElement>('#n-canale').value === 'Struttura partner';
    $('[data-campo-struttura]').hidden = !struttura;
    if (struttura) {
      if (!strutture.length) strutture = (await api('/api/gestione/strutture')).strutture;
      $<HTMLSelectElement>('#n-struttura').innerHTML = strutture.filter((s) => s.attivo).map((s) => `<option value="${s.id}">${h(s.nome)}</option>`).join('');
    }
  });
  $('[data-modulo-nuova]').addEventListener('submit', async (ev) => {
    ev.preventDefault(); pulisciErrore();
    const f = ev.target as HTMLFormElement;
    if (!f.nome.value.trim()) { f.nome.focus(); return errore(new Error('Inserisci il nome del cliente.')); }
    const corpo: any = Object.fromEntries(new FormData(f).entries());
    corpo.pagato = f.pagato.checked;
    corpo.link = f.link.checked;
    corpo.ore = Number(corpo.ore);
    if (corpo.canale !== 'Struttura partner') delete corpo.partnerId;
    try {
      const r = await api('/api/gestione/prenotazioni', { corpo });
      const ok = $('[data-esito-nuova]');
      ok.textContent = corpo.link ? `Posti tenuti: ${r.codice} su ${r.gommone}. Manda il link al cliente.` : `Inserita: ${r.codice} su ${r.gommone}.`;
      ok.hidden = false;
      $('[data-esito-link]').innerHTML = corpo.link && r.link ? boxLink(r.link, r.nome, r.telefono, r.daPagare, r.inviata) : '';
      ['nome', 'telefono', 'email', 'rifEsterno', 'importo', 'note'].forEach((k) => (f[k].value = ''));
      f.pagato.checked = false;
      controllaPosti();
    } catch (e) { errore(e); }
  });

  // ---------- Elenco ----------
  let ultimeRighe: any[] = [];
  async function caricaElenco() {
    const f = $<HTMLFormElement>('[data-filtri]');
    const q = new URLSearchParams(Object.entries(Object.fromEntries(new FormData(f).entries())).filter(([, v]) => v) as [string, string][]);
    try {
      const d = await api(`/api/gestione/prenotazioni?${q}`);
      if (!f.dal.value) f.dal.value = d.dal;
      if (!f.al.value) f.al.value = d.al;
      ultimeRighe = d.prenotazioni;
      d.prenotazioni.forEach(ricorda);
      $('[data-elenco]').innerHTML = d.prenotazioni.length ? d.prenotazioni.map((p: any) => `<tr>
        <td>${h(dataBreve(p.data))}</td><td>${h(p.codice)}</td>
        <td>${h(p.escursione)}<br><span class="testo-2">${h(p.turno)} · ${h(p.gommone)}</span></td>
        <td>${h(p.nome)}${p.telefono ? `<br>${h(p.telefono)} ${wa(p.telefono)}` : ''}</td>
        <td class="num">${p.adulti + p.bambini + p.neonati}</td>
        <td class="num">${euro(p.totale)}${p.pagato && p.pagato !== p.totale ? `<br><span class="testo-2">pagato ${euro(p.pagato)}</span>` : ''}</td>
        <td>${h(p.canale)}${p.struttura ? `<br><span class="testo-2">${h(p.struttura)}</span>` : ''}</td>
        <td><span class="stato stato--${h(p.stato)}">${h(p.stato === 'in_attesa' ? 'Aspetta il pagamento' : STATI[p.stato] || p.stato)}</span>${statoRimborso(p) !== '—' ? `<br>${statoRimborso(p)}` : ''}${p.daPagare > 0 && p.stato === 'confermata' ? `<br><span class="stato stato--attenzione">da pagare ${euro(p.daPagare)}</span>` : ''}${p.checkin ? '<br><span class="stato stato--ok">A bordo</span>' : ''}</td>
        <td><button class="btn btn--bordo btn--piccolo" type="button" data-gestisci="${p.id}">Gestisci</button></td></tr>`).join('') : '<tr><td class="vuota" colspan="9">Nessuna prenotazione.</td></tr>';
    } catch (e) { errore(e); }
  }
  $('[data-filtri]').addEventListener('submit', (ev) => { ev.preventDefault(); caricaElenco(); });
  $('[data-elenco]').addEventListener('click', (ev) => {
    const b = (ev.target as Element).closest<HTMLElement>('[data-gestisci]');
    if (b) apriAzioni(Number(b.dataset.gestisci), caricaElenco);
  });

  // ---------- Strutture ----------
  async function caricaStrutture() {
    try {
      strutture = (await api('/api/gestione/strutture')).strutture;
      $('[data-strutture]').innerHTML = strutture.length ? strutture.map((s) => `<tr>
        <td><strong>${h(s.nome)}</strong><br><span class="testo-2">${h(s.codice)}${s.attivo ? '' : ' · disattivata'}</span></td>
        <td>${h(s.referente || '')}${s.telefono ? `<br>${h(s.telefono)}` : ''}<br><span class="testo-2">${h(s.email || '')}</span></td>
        <td class="num">${s.provvigione}</td><td class="num">${euro(s.venduto)}<br><span class="testo-2">${s.numero} pren.</span></td>
        <td class="num">${euro(s.maturata)}</td><td class="num">${euro(s.liquidata)}</td><td class="num"><strong>${euro(s.daPagare)}</strong></td>
        <td><div class="azioni-riga">
          <button class="btn btn--bordo btn--piccolo" type="button" data-struttura="${s.attivo ? 'disattiva' : 'riattiva'}" data-id="${s.id}">${s.attivo ? 'Disattiva' : 'Riattiva'}</button>
          <button class="btn btn--bordo btn--piccolo" type="button" data-struttura="nuova-password" data-id="${s.id}">Nuova password</button>
        </div><div data-pw="${s.id}"></div></td></tr>`).join('') : '<tr><td class="vuota" colspan="8">Nessuna struttura ancora.</td></tr>';
    } catch (e) { errore(e); }
  }
  const messaggioAccesso = (nome: string, email: string, password: string, codice: string) =>
    `Ciao! Ecco l'accesso all'area strutture di Escursioni La Maddalena per ${nome}.\nIndirizzo: ${location.origin}/partner/\nEmail: ${email}\nPassword provvisoria: ${password} (al primo accesso ne sceglierai una tua)\nLink per i vostri ospiti: ${location.origin}/prenota/?p=${codice}`;
  $('[data-strutture]').addEventListener('click', async (ev) => {
    const b = (ev.target as Element).closest<HTMLElement>('[data-struttura]');
    if (!b) return;
    const s = strutture.find((x) => x.id === Number(b.dataset.id));
    try {
      if (b.dataset.struttura === 'nuova-password') {
        const r = await api('/api/gestione/strutture', { corpo: { azione: 'nuova-password', id: s.id } });
        document.querySelector(`[data-pw="${s.id}"]`)!.innerHTML = `<p style="margin-top:8px">Nuova password, da mandare alla struttura:</p><p class="password-nuova">${h(r.password)}</p>`;
        return;
      }
      await api('/api/gestione/strutture', { corpo: { azione: 'modifica', id: s.id, nome: s.nome, telefono: s.telefono || '', referente: s.referente || '', provvigione: s.provvigione, attivo: b.dataset.struttura === 'riattiva' } });
      caricaStrutture();
    } catch (e) { errore(e); }
  });
  $('[data-modulo-struttura]').addEventListener('submit', async (ev) => {
    ev.preventDefault(); pulisciErrore();
    const f = ev.target as HTMLFormElement;
    try {
      const corpo: any = Object.fromEntries(new FormData(f).entries());
      const r = await api('/api/gestione/strutture', { corpo: { azione: 'crea', ...corpo } });
      const testo = messaggioAccesso(corpo.nome, r.email, r.password, r.codice);
      $('[data-esito-struttura]').innerHTML = `<div class="messaggio-ok">Struttura creata. Manda questi dati alla struttura (la password non sarà più visibile):</div>
        <textarea rows="6" readonly>${h(testo)}</textarea>
        <div class="azioni-riga"><a class="btn btn--bordo btn--piccolo" href="mailto:${h(r.email)}?subject=${encodeURIComponent('Accesso area strutture Escursioni La Maddalena')}&body=${encodeURIComponent(testo)}">Manda per email</a></div>`;
      f.reset();
      caricaStrutture();
    } catch (e) { errore(e); }
  });

  // ---------- Provvigioni ----------
  let righeProvvigioni: any[] = [];
  let periodoCorrente: any = null;
  async function caricaProvvigioni(dal?: string) {
    try {
      const d = await api(`/api/gestione/provvigioni${dal ? `?dal=${dal}` : ''}`);
      periodoCorrente = d.periodo;
      righeProvvigioni = d.strutture;
      const sel = $<HTMLSelectElement>('#p-periodo');
      sel.innerHTML = d.quindicine.map((q: any) => `<option value="${q.dal}" ${q.dal === d.periodo.dal ? 'selected' : ''}>${h(dataBreve(q.dal))} – ${h(dataBreve(q.al))}</option>`).join('');
      if (!d.quindicine.some((q: any) => q.dal === d.periodo.dal)) sel.insertAdjacentHTML('afterbegin', `<option value="${d.periodo.dal}" selected>${h(dataBreve(d.periodo.dal))} – ${h(dataBreve(d.periodo.al))}</option>`);
      $('[data-provvigioni]').innerHTML = d.strutture.length ? d.strutture.map((s: any) => `<tr>
        <td><strong>${h(s.nome)}</strong><br><span class="testo-2">${h(s.email || '')}</span></td>
        <td class="num">${s.numero}</td><td class="num">${euro(s.venduto)}</td><td class="num"><strong>${euro(s.provvigione)}</strong></td>
        <td>${s.pagato !== null ? `<span class="stato stato--ok">Pagata ${euro(s.pagato)} il ${h(new Date(s.pagataIl).toLocaleDateString('it-IT'))}</span>`
          : !s.provvigione ? '—'
          : d.concluso ? `<button class="btn btn--scuro btn--piccolo" type="button" data-liquida="${s.id}">Segna come pagata</button>`
          : '<span class="stato">Quindicina in corso</span>'}</td></tr>`).join('') : '<tr><td class="vuota" colspan="5">Nessuna struttura.</td></tr>';
    } catch (e) { errore(e); }
  }
  $('#p-periodo').addEventListener('change', () => caricaProvvigioni($<HTMLSelectElement>('#p-periodo').value));
  $('[data-provvigioni]').addEventListener('click', async (ev) => {
    const b = (ev.target as Element).closest<HTMLElement>('[data-liquida]');
    if (!b) return;
    if (!window.confirm('Confermi di aver pagato la provvigione di questa quindicina?')) return;
    try { await api('/api/gestione/provvigioni', { corpo: { partnerId: Number(b.dataset.liquida), dal: periodoCorrente.dal } }); caricaProvvigioni(periodoCorrente.dal); } catch (e) { errore(e); }
  });

  // ---------- CSV ----------
  function scaricaCsv(nome: string, intestazione: string[], righe: (string | number)[][]) {
    const cella = (v: unknown) => `"${String(v ?? '').replace(/"/g, '""')}"`;
    const testo = '﻿' + [intestazione, ...righe].map((r) => r.map(cella).join(';')).join('\r\n');
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([testo], { type: 'text/csv;charset=utf-8' }));
    a.download = nome;
    a.click();
  }
  document.querySelectorAll<HTMLButtonElement>('[data-csv]').forEach((b) => b.addEventListener('click', () => {
    if (b.dataset.csv === 'elenco') scaricaCsv('prenotazioni.csv', ['Data', 'Codice', 'Escursione', 'Orario', 'Gommone', 'Nome', 'Telefono', 'Email', 'Adulti', 'Bambini 0–10', 'Imbarco', 'Totale', 'Pagato', 'Provvigione', 'Canale', 'Struttura', 'Stato', 'Rimborso', 'Note'],
      ultimeRighe.map((p) => [p.data, p.codice, p.escursione, p.turno, p.gommone, p.nome, p.telefono, p.email, p.adulti, p.bambini + p.neonati, p.imbarco, String(p.totale).replace('.', ','), String(p.pagato).replace('.', ','), String(p.provvigione).replace('.', ','), p.canale, p.struttura, p.stato, p.rimborso, p.note]));
    // (le colonne restano quelle di sempre; il report completo è nelle Statistiche)
    else scaricaCsv(`provvigioni-${periodoCorrente?.dal}.csv`, ['Struttura', 'Email', 'Prenotazioni', 'Venduto', 'Provvigione', 'Pagata il'],
      righeProvvigioni.map((s) => [s.nome, s.email, s.numero, String(s.venduto).replace('.', ','), String(s.provvigione).replace('.', ','), s.pagataIl ? new Date(s.pagataIl).toLocaleDateString('it-IT') : '']));
  }));


  // ---------- Strumenti comuni ----------
  const prenotazioniViste = new Map<number, any>();
  const ricorda = (p: any) => prenotazioniViste.set(p.id, p);
  const PAGATA_SUL_SITO = ['sumup', 'paypal', 'prova'];
  function statoRimborso(p: any) {
    if (p.stato === 'annullata' && p.recupero === 'proposto') return '<span class="stato stato--attenzione">Maltempo: aspetta la scelta</span>';
    if (p.rimborso === 'da_fare') return `<span class="stato stato--attenzione">Rimborso da fare: ${euro(p.pagato - (p.rimborsato || 0))}</span>`;
    if (p.rimborso === 'fatto') return `<span class="stato stato--ok">Rimborsata ${p.rimborsato ? euro(p.rimborsato) : ''}</span>`;
    if (p.recupero === 'rinviata') return '<span class="stato stato--ok">Rinviata</span>';
    return '—';
  }
  async function copia(testo: string, bottone?: HTMLElement) {
    try { await navigator.clipboard.writeText(testo); if (bottone) { const v = bottone.textContent; bottone.textContent = 'Copiato'; setTimeout(() => (bottone.textContent = v), 1500); } }
    catch { window.prompt('Copia questo testo:', testo); }
  }
  document.addEventListener('click', (ev) => {
    const b = (ev.target as Element).closest<HTMLElement>('[data-copia]');
    if (b) copia(b.dataset.copia!, b);
  });
  const boxLink = (link: string, nome: string, telefono: string, importo: number, inviata: boolean) => {
    const testo = `Ciao ${nome || ''}, ecco il link per pagare la prenotazione con carta o PayPal (${euro(importo)}): ${link}`;
    return `<div class="area-scheda" style="background:#EEF7FC;margin-top:12px"><p><strong>Link di pagamento</strong>${inviata ? ' · <span class="stato stato--ok">mandato per email</span>' : ''}</p>
      <div class="copia"><input readonly value="${h(link)}" aria-label="Link di pagamento" /><button type="button" class="btn btn--bordo btn--piccolo" data-copia="${h(link)}">Copia</button></div>
      <div class="azioni-riga">${telefono ? wa(telefono, testo).replace('>WhatsApp<', ' class="btn btn--wa btn--piccolo">Manda su WhatsApp<') : ''}<button type="button" class="btn btn--bordo btn--piccolo" data-copia="${h(testo)}">Copia il messaggio</button></div></div>`;
  };
  const opzioniEscursioni = (tutte = true) => (tutte ? '<option value="">Tutte</option>' : '') + Object.entries(titoli).map(([slug, t]) => `<option value="${h(slug)}">${h(t)}</option>`).join('');
  document.querySelectorAll<HTMLSelectElement>('[data-escursioni-tutte]').forEach((s) => (s.innerHTML = opzioniEscursioni()));
  const nomeEscursioni = (csv: string | null) => (csv ? csv.split(',').map((x) => titoli[x] || x).join(', ') : 'Tutte le escursioni');
  const periodoTesto = (dal: string | null, al: string | null) => (dal || al ? `${dal ? `dal ${dataBreve(dal)}` : ''} ${al ? `al ${dataBreve(al)}` : ''}`.trim() : '');

  // ---------- Finestra delle azioni su una prenotazione ----------
  const dialogo = $<HTMLDialogElement>('[data-dialogo]');
  $('[data-dlg-chiudi]').addEventListener('click', () => dialogo.close());
  let dopoAzione: () => void = () => {};
  let corrente: any = null;
  function apriAzioni(id: number, aggiorna: () => void) {
    const p = prenotazioniViste.get(id);
    if (!p) return;
    corrente = p;
    dopoAzione = aggiorna;
    const attiva = p.stato === 'confermata' || p.stato === 'da_verificare';
    const maltempo = p.stato === 'annullata' && p.recupero === 'proposto';
    const rimborsabile = (p.pagato || 0) - (p.rimborsato || 0);
    const online = PAGATA_SUL_SITO.includes(p.metodo);
    const turni = offerte[p.escursioneSlug]?.turni ?? [];
    $('[data-dlg-titolo]').textContent = `${p.codice} · ${p.nome}`;
    const blocchi: string[] = [];
    blocchi.push(`<div class="azione-blocco"><p>${h(p.escursione)} · ${h(p.turno)}<br>${h(dataLunga(p.data))} · ${h(persone(p.adulti, p.bambini, p.neonati))} · ${h(p.imbarco)}<br>
      Totale ${euro(p.totale)} · pagato ${euro(p.pagato || 0)}${p.buono ? ` · buono ${euro(p.buono)}` : ''}${p.rimborsato ? ` · rimborsato ${euro(p.rimborsato)}` : ''} ${p.metodo ? `(${h(p.metodo)})` : ''}</p>
      ${p.telefono ? `<p>${h(p.telefono)} ${wa(p.telefono)}${p.email ? ` · ${h(p.email)}` : ''}</p>` : p.email ? `<p>${h(p.email)}</p>` : ''}
      <p class="avviso" data-dlg-errore hidden role="alert"></p><p class="messaggio-ok" data-dlg-ok hidden></p></div>`);
    if (p.stato === 'da_verificare') blocchi.push(`<div class="azione-blocco"><h3>Pagamento arrivato in ritardo</h3><p class="testo-2">Controlla che ci sia ancora posto, poi conferma.</p><div class="azioni-riga"><button type="button" class="btn btn--scuro btn--piccolo" data-az="conferma">Conferma la prenotazione</button></div></div>`);
    if (attiva || maltempo) blocchi.push(`<div class="azione-blocco"><h3>${maltempo ? 'Rinvia (al posto del cliente)' : 'Sposta a un altro giorno o orario'}</h3>
      <div class="riga-campi"><div class="campo"><label for="dlg-data">Giorno</label><input id="dlg-data" type="date" value="${h(p.data)}" /></div>
      <div class="campo"><label for="dlg-turno">Orario</label><select id="dlg-turno">${turni.map((t: any) => `<option value="${h(t.id)}" ${t.id === p.turnoId ? 'selected' : ''}>${h(t.nome)}</option>`).join('')}</select></div></div>
      <p class="testo-2" data-dlg-posti aria-live="polite"></p>
      <label class="spunta-riga"><input type="checkbox" data-dlg-avvisa checked /><span>Manda al cliente l'email con la nuova data</span></label>
      <div class="azioni-riga"><button type="button" class="btn btn--scuro btn--piccolo" data-az="sposta">Sposta</button></div><p class="testo-2" style="font-size:13px">Il prezzo resta quello già pagato.</p></div>`);
    if (p.pagabile) blocchi.push(`<div class="azione-blocco"><h3>Link di pagamento</h3><p class="testo-2">${p.stato === 'in_attesa' ? 'I posti sono tenuti finché il cliente non paga o il link scade.' : 'Il cliente paga online quello che manca.'}</p>
      <div class="azioni-riga"><button type="button" class="btn btn--scuro btn--piccolo" data-az="link">Mostra il link</button>${p.email ? '<button type="button" class="btn btn--bordo btn--piccolo" data-az="link-email">Manda il link per email</button>' : ''}</div><div data-dlg-link></div></div>`);
    if (rimborsabile > 0 && online && (p.stato !== 'annullata' || p.rimborso === 'da_fare')) blocchi.push(`<div class="azione-blocco"><h3>Rimborso automatico</h3><p class="testo-2">Con ${p.metodo === 'paypal' ? 'PayPal' : p.metodo === 'sumup' ? 'SumUp' : 'il pagamento di prova'}, sullo stesso metodo del cliente. Si può rimborsare anche solo una parte.</p>
      <div class="riga-campi"><div class="campo"><label for="dlg-importo">Importo (€)</label><input id="dlg-importo" inputmode="decimal" value="${String(rimborsabile).replace('.', ',')}" /></div>
      <div class="azioni-riga"><button type="button" class="btn btn--scuro btn--piccolo" data-az="rimborsa">Rimborsa</button></div></div></div>`);
    if (p.rimborso === 'da_fare') blocchi.push(`<div class="azione-blocco"><h3>Rimborso fatto a mano</h3><p class="testo-2">Se hai già rimborsato dal pannello di SumUp o PayPal, dalla piattaforma o in contanti.</p><div class="azioni-riga"><button type="button" class="btn btn--bordo btn--piccolo" data-az="rimborsata">Segna come fatto</button></div></div>`);
    if (attiva || p.stato === 'in_attesa') blocchi.push(`<div class="azione-blocco"><h3>Annulla la prenotazione</h3>
      <div class="scelte-radio">
        ${p.pagato > 0 && online ? '<label><input type="radio" name="dlg-modo" value="rimborso" checked /><span><strong>Rimborso completo automatico</strong><br>Il cliente riceve i soldi e un\'email.</span></label>' : ''}
        ${p.stato !== 'in_attesa' ? `<label><input type="radio" name="dlg-modo" value="proposta" ${p.pagato > 0 && online ? '' : 'checked'} /><span><strong>Lascia scegliere il cliente</strong><br>Riceve un link per scegliere un'altra data o il rimborso (come per il maltempo).</span></label>` : ''}
        ${p.pagato > 0 && !online ? '<label><input type="radio" name="dlg-modo" value="manuale" /><span><strong>Rimborso da fare a mano</strong><br>Sulla piattaforma, in contanti o con bonifico: resta nell\'elenco "rimborsi da fare".</span></label>' : ''}
        <label><input type="radio" name="dlg-modo" value="senza-rimborso" ${p.stato === 'in_attesa' ? 'checked' : ''} /><span><strong>Senza rimborso</strong><br>Per esempio: annullata a meno di ${regole.cancellazioneGratisOre} ore dalla partenza, o cliente che non si presenta.</span></label>
      </div>
      <div class="campo"><label for="dlg-motivo">Motivo (facoltativo)</label><input id="dlg-motivo" maxlength="200" /></div>
      <div class="azioni-riga"><button type="button" class="btn btn--avviso btn--piccolo" data-az="annulla">Annulla la prenotazione</button></div></div>`);
    if (maltempo) blocchi.push(`<div class="azione-blocco"><h3>Il cliente deve ancora scegliere</h3><p class="testo-2">Mandagli il suo link: sceglie lui tra un'altra data e il rimborso.</p><div class="azioni-riga"><button type="button" class="btn btn--bordo btn--piccolo" data-az="link-scelta">Mostra il link</button>${online && rimborsabile > 0 ? '<button type="button" class="btn btn--scuro btn--piccolo" data-az="rimborsa-tutto">Rimborsa adesso (al posto suo)</button>' : ''}</div><div data-dlg-link></div></div>`);
    $('[data-dlg-corpo]').innerHTML = blocchi.join('');
    dialogo.showModal();
    if (attiva || maltempo) controllaPostiSposta(p);
  }
  async function controllaPostiSposta(p: any) {
    const data = $<HTMLInputElement>('#dlg-data')?.value, turno = $<HTMLSelectElement>('#dlg-turno')?.value;
    const box = document.querySelector<HTMLElement>('[data-dlg-posti]');
    if (!box || !data) return;
    try {
      const d = await api(`/api/disponibilita?escursione=${p.escursioneSlug}&mese=${data.slice(0, 7)}&gestione=1&imbarco=${p.imbarcoId}`);
      const t = d.giorni[data]?.turni?.find((x: any) => x.id === turno);
      const persone = p.adulti + p.bambini + p.neonati;
      box.textContent = data === p.data && turno === p.turnoId && p.stato !== 'annullata' ? 'È il giorno e l\'orario di adesso.' : !t ? 'Data fuori stagione o passata.' : t.disponibile && t.max >= persone ? `C'è posto (fino a ${t.max} persone).` : `Non c'è posto per ${persone} persone.`;
    } catch (e) { box.textContent = (e as Error).message; }
  }
  dialogo.addEventListener('change', (ev) => {
    if ((ev.target as HTMLElement).matches('#dlg-data, #dlg-turno') && corrente) controllaPostiSposta(corrente);
  });
  dialogo.addEventListener('click', async (ev) => {
    const b = (ev.target as Element).closest<HTMLButtonElement>('[data-az]');
    if (!b) return;
    const p = corrente;
    if (!p) return;
    const err = dialogo.querySelector<HTMLElement>('[data-dlg-errore]')!;
    const ok = dialogo.querySelector<HTMLElement>('[data-dlg-ok]')!;
    err.hidden = true; ok.hidden = true;
    const az = b.dataset.az!;
    const chiama = (corpo: any) => api('/api/gestione/prenotazione', { corpo: { id: p.id, ...corpo } });
    b.disabled = true;
    try {
      if (az === 'sposta') {
        await chiama({ azione: 'sposta', data: $<HTMLInputElement>('#dlg-data').value, turno: $<HTMLSelectElement>('#dlg-turno').value, avvisa: dialogo.querySelector<HTMLInputElement>('[data-dlg-avvisa]')!.checked });
        dialogo.close(); dopoAzione(); return;
      }
      if (az === 'link' || az === 'link-email') {
        const r = await chiama({ azione: 'link', invia: az === 'link-email' });
        b.closest('.azione-blocco')!.querySelector('[data-dlg-link]')!.innerHTML = boxLink(r.link, p.nome, p.telefono, p.daPagare, r.inviata);
        b.disabled = false; return;
      }
      if (az === 'link-scelta') {
        const r = await chiama({ azione: 'link-cliente' });
        const testo = `Ciao ${p.nome}, purtroppo l'uscita del ${dataLunga(p.data)} è annullata per le condizioni del mare. Scegli tu: un'altra data o il rimborso completo, da qui: ${r.link}`;
        b.closest('.azione-blocco')!.querySelector('[data-dlg-link]')!.innerHTML = `<div class="copia" style="margin-top:8px"><input readonly value="${h(r.link)}" aria-label="Link del cliente" /><button type="button" class="btn btn--bordo btn--piccolo" data-copia="${h(r.link)}">Copia</button></div><div class="azioni-riga" style="margin-top:8px">${p.telefono ? wa(p.telefono, testo).replace('>WhatsApp<', ' class="btn btn--wa btn--piccolo">Manda su WhatsApp<') : ''}<button type="button" class="btn btn--bordo btn--piccolo" data-copia="${h(testo)}">Copia il messaggio</button></div>`;
        b.disabled = false; return;
      }
      if (az === 'rimborsa' || az === 'rimborsa-tutto') {
        const importo = az === 'rimborsa' ? $<HTMLInputElement>('#dlg-importo').value : String(p.pagato - (p.rimborsato || 0));
        if (!window.confirm(`Rimborsare ${importo.replace('.', ',')} € a ${p.nome}?`)) { b.disabled = false; return; }
        if (az === 'rimborsa-tutto') await chiama({ azione: 'rimborso-maltempo' });
        else await chiama({ azione: 'rimborsa', importo });
        dialogo.close(); dopoAzione(); return;
      }
      if (az === 'annulla') {
        const modo = dialogo.querySelector<HTMLInputElement>('[name="dlg-modo"]:checked')?.value || 'senza-rimborso';
        if (!window.confirm(`Annullare la prenotazione ${p.codice}?`)) { b.disabled = false; return; }
        const r = await chiama({ azione: 'annulla', modo, motivo: $<HTMLInputElement>('#dlg-motivo').value });
        if (r.rimborso && r.rimborso.ok === false) { err.textContent = `Annullata, ma il rimborso non è riuscito: ${r.rimborso.errore}`; err.hidden = false; dopoAzione(); return; }
        if (r.link) { ok.innerHTML = `Annullata. ${r.email ? 'Il cliente ha ricevuto l\'email per scegliere.' : 'Manda al cliente il suo link per scegliere:'}`; ok.hidden = false; b.closest('.azione-blocco')!.innerHTML = boxLink(r.link, p.nome, p.telefono, 0, r.email).replace('Link di pagamento', 'Link per scegliere rinvio o rimborso').replace(/ecco il link per pagare la prenotazione con carta o PayPal \([^)]*\)/, 'la tua uscita è annullata per il maltempo: scegli un\'altra data o il rimborso'); dopoAzione(); return; }
        dialogo.close(); dopoAzione(); return;
      }
      await chiama({ azione: az });
      dialogo.close(); dopoAzione();
    } catch (e) { err.textContent = (e as Error).message; err.hidden = false; b.disabled = false; }
  });


