          ${cifra('Maltempo', `${d.maltempo.rinviate} rinviate`, `${euro(d.maltempo.rinviateValore)} salvati · ${d.maltempo.rimborsate} rimborsate · ${d.maltempo.inAttesaDiScelta} aspettano`)}
