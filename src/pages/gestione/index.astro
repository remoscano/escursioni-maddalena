    const max = Math.max(1, ...righe.map((r) => r[campo]));
    return `<div class="grafico-barre">${righe.map((r) => `<div><span>${h(r.nome)}</span><span class="barra" style="width:${Math.round((r[campo] / max) * 100)}%"></span><span>${euro(r[campo])}</span></div>`).join('')}</div>`;
  };
