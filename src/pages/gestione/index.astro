  // ---------- Statistiche ----------
  let ultimeStat: any = null;
  function periodoStat() {
    const f = $<HTMLFormElement>('[data-filtri-stat]');
    const oggi = oggiRoma();
    const [a, m] = oggi.split('-');
    const fine = (anno: number, mese: number) => new Date(Date.UTC(anno, mese, 0)).toISOString().slice(0, 10);
    const scelta = f.periodo.value;
    if (scelta === 'anno') { f.dal.value = `${a}-01-01`; f.al.value = `${a}-12-31`; }
    if (scelta === 'stagione') { f.dal.value = regole.stagione.dal; f.al.value = regole.stagione.al; }
    if (scelta === 'mese') { f.dal.value = `${a}-${m}-01`; f.al.value = fine(Number(a), Number(m)); }
    if (scelta === 'scorso') { const d = new Date(Date.UTC(Number(a), Number(m) - 2, 1)); f.dal.value = d.toISOString().slice(0, 10); f.al.value = fine(d.getUTCFullYear(), d.getUTCMonth() + 1); }
  }
  $('#st-periodo').addEventListener('change', () => { periodoStat(); caricaStatistiche(); });
