---
import Base from '../layouts/Base.astro';
import Icona from '../components/Icona.astro';
---
<Base titolo="Pagina non trovata" descrizione="La pagina che cerchi non esiste.">
  <section class="testa-pagina" style="padding-bottom:112px">
    <div class="contenitore">
      <p class="occhiello">Errore 404</p>
      <h1>Questa cala non c'è sulla mappa</h1>
      <p class="intro">La pagina che cerchi non esiste o è stata spostata.</p>
      <div class="azioni" style="margin-top:32px">
        <a href="/" class="btn btn--bordo">Torna alla home</a>
        <a href="/escursioni/" class="btn btn--wa">Vedi le escursioni<Icona nome="destra" /></a>
      </div>
    </div>
  </section>
</Base>
