---
import Base from '../layouts/Base.astro';
import ModuloRichiesta from '../components/ModuloRichiesta.astro';
import Dato from '../components/Dato.astro';
import { sito } from '../data/sito.js';
import { regole } from '../data/prenotazioni.js';
const { contatti } = sito;
---
<Base
  titolo="Richiesta di disponibilità su WhatsApp"
  descrizione="Scegli escursione, data, persone e punto d'imbarco: si apre WhatsApp con il messaggio già pronto e ti rispondiamo con disponibilità e orari."
>
  <section class="testa-pagina" style="padding-bottom:0">
    <div class="contenitore" style="max-width:760px">
      <p class="occhiello">Richiesta su WhatsApp</p>
      <h1>Tre scelte e il messaggio è pronto</h1>
      <p class="intro">Ti rispondiamo su WhatsApp con disponibilità, orario di ritrovo e molo.{regole.attive
        ? <Fragment> Per prenotare e pagare subito, senza aspettare la risposta: <a href="/prenota/">prenota online</a>.</Fragment>
        : ' Nessun pagamento online.'}</p>
    </div>
  </section>
  <section class="sezione" style="padding-top:40px">
    <div class="contenitore" style="max-width:760px;display:flex;flex-direction:column;gap:24px">
      <ModuloRichiesta chiaro titolo="La tua richiesta" />
      <p class="testo-2" style="text-align:center;font-size:16px">
        Preferisci chiamare? {contatti.telefonoVisibile
          ? <a href={`tel:+${contatti.whatsapp}`} style="font-weight:700">{contatti.telefonoVisibile}</a>
          : <Dato e="+39 numero" />}
      </p>
    </div>
  </section>
</Base>
