---
import Base from '../layouts/Base.astro';
import Gommone from '../components/Gommone.astro';
import Foto from '../components/Foto.astro';
import Icona from '../components/Icona.astro';
import Dato from '../components/Dato.astro';
import SezioneRichiesta from '../components/SezioneRichiesta.astro';
---
<Base
  titolo="Il maxi gommone e lo skipper"
  descrizione="Il maxi gommone con cui esploriamo l'Arcipelago di La Maddalena e lo skipper che vi accompagna: comodità, sicurezza e dotazioni a bordo."
>
  <section class="sezione" style="padding-top:56px" aria-labelledby="gommone-titolo">
    <div class="contenitore">
      <Gommone titoloLivello="h1" link={false} />
    </div>
  </section>

  <section class="sezione sezione--calda" aria-labelledby="bordo-titolo">
    <div class="contenitore pila">
      <div class="intestazione__testo">
        <p class="occhiello">A bordo</p>
        <h2 id="bordo-titolo" class="titolo-sezione">Comodi e sicuri, tutto il giorno</h2>
      </div>
      <div class="griglia-info">
        <div class="box">
          <span class="box__icona"><Icona nome="sole" size={24} tratto={1.8} /></span>
          <h3>Ombra e comodità</h3>
          <p><Dato e="Tendalino, sedute, prendisole: cosa c'è a bordo" /></p>
        </div>
        <div class="box">
          <span class="box__icona"><Icona nome="persone" size={24} tratto={1.8} /></span>
          <h3>Sicurezza</h3>
          <p>Giubbotti di salvataggio per adulti e bambini e dotazioni di sicurezza previste per legge.</p>
          <p><Dato e="Patente nautica, assicurazione, certificazioni" /></p>
        </div>
        <div class="box">
          <span class="box__icona"><Icona nome="ancora" size={24} tratto={1.8} /></span>
          <h3>Per fare il bagno</h3>
          <p><Dato e="Scaletta, doccetta, maschere e boccagli?" /></p>
        </div>
        <div class="box">
          <span class="box__icona"><Icona nome="borsa" size={24} tratto={1.8} /></span>
          <h3>Bagagli</h3>
          <p>Porta solo una borsa morbida: a bordo lo spazio è prezioso. <Dato e="Gavone stagno per telefoni e documenti?" /></p>
        </div>
      </div>
    </div>
  </section>

  <section class="sezione" aria-label="Foto di bordo">
    <div class="contenitore galleria">
      <Foto nota="Il gommone in navigazione, visto da un'altra barca" class="galleria__grande" />
      <div class="galleria__piccole">
        <Foto nota="Lo skipper al timone" tono="sabbia" />
        <Foto nota="Ospiti a prua" />
        <Foto nota="La scaletta per il bagno" tono="rosa" />
        <Foto nota="Il tendalino aperto" />
      </div>
    </div>
  </section>

  <SezioneRichiesta />
</Base>
