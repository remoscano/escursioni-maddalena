---
import { regole, postiMassimi } from '../data/prenotazioni.js';
import { sito } from '../data/sito.js';
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import Icona from '../components/Icona.astro';
import Dato from '../components/Dato.astro';
import Mappa from '../components/Mappa.astro';
import ElencoSoste from '../components/ElencoSoste.astro';
import SchedaEscursione from '../components/SchedaEscursione.astro';
import Gommone from '../components/Gommone.astro';
import BoxInfo from '../components/BoxInfo.astro';
import SezioneRichiesta from '../components/SezioneRichiesta.astro';
import { escursioni, trovaEscursione } from '../data/escursioni.js';

const tour = trovaEscursione('tour-7-isole');
// I due percorsi della mezza giornata, dal programma dell'escursione (voci "percorso" seguite dalle loro soste).
const percorsiMezza: { titolo: string; testo: string; soste: any[] }[] = [];
for (const t of trovaEscursione('mezza-giornata').programma) {
  if (t.tipo === 'percorso') percorsiMezza.push({ titolo: t.titolo, testo: t.testo, soste: [] });
  else if ((t.tipo === 'sosta' || t.tipo === 'vista') && percorsiMezza.length) percorsiMezza.at(-1)!.soste.push(t);
}
// Solo i due giri (la riga introduttiva non ha soste).
percorsiMezza.splice(0, percorsiMezza.length, ...percorsiMezza.filter((p) => p.soste.length));
// Prezzo più basso a persona tra le uscite di gruppo, per l'apertura.
const prezzoMinimo = Math.min(...escursioni.filter((e) => !e.prezzoGommone).map((e) => Number(e.prezzoAdulti)));
const altre = escursioni.filter((e) => !e.inEvidenza);
import DatiStrutturati from '../components/DatiStrutturati.astro';
import { pagineImbarco } from '../data/imbarchi.js';
const partenze = pagineImbarco.map((p) => ({ href: p.href, titolo: p.titoloPagina, testo: p.breve }));
---
<Base
  titolo="Escursioni in barca Arcipelago di La Maddalena"
  descrizione={`Escursioni in barca nell'Arcipelago di La Maddalena, partenza da La Maddalena, Palau e Cannigione: giro delle isole, mezza giornata, tramonto, Corsica. Da ${prezzoMinimo} €.`}
>
  <DatiStrutturati slot="head" tipo="attivita" />
  <section slot="hero" class="hero" aria-label="Apertura">
    <div class="hero__griglia">
      <div class="hero__contenuto">
        <p class="hero__occhiello">Partenza da La Maddalena, Palau e Cannigione · Sardegna</p>
        <h1 class="hero__titolo">Escursioni in barca Arcipelago di La Maddalena</h1>
        <p class="hero__testo">Gite in gommone con skipper nell'arcipelago di La Maddalena: il giro delle isole (Tour delle 7 isole), l'escursione di mezza giornata, l'aperitivo al tramonto, il tour privato in esclusiva e l'escursione in Corsica. Si parte dal porto di La Maddalena, con passaggio a Palau per chi si imbarca lì, e da Cannigione.</p>
        <div class="hero__azioni">
          {regole.attive
            ? <a href="/prenota/" class="btn btn--wa btn--grande">Prenota online</a>
            : <a href="/richiesta/" class="btn btn--wa btn--grande"><Icona nome="whatsapp" />Chiedi disponibilità su WhatsApp</a>}
          <a href="#escursioni" class="btn btn--bordo btn--grande">Scegli l'escursione<Icona nome="giu" /></a>
        </div>
      </div>
      <Foto
        class="hero__foto"
        nota="un gommone in planata tra le isole dell'arcipelago, vista dall'alto (almeno 2000 px)"
        priorita
        sizes="(max-width: 960px) 100vw, 50vw"
      />
    </div>
    <div class="hero__fatti">
      <dl>
        <div><dt><Icona nome="orologio" size={18} />Uscite</dt><dd>Mezza giornata, giornata intera, Sunset al tramonto</dd></div>
        <div><dt><Icona nome="ancora" size={18} />Imbarco</dt><dd>{sito.partenze.breve}</dd></div>
        <div><dt><Icona nome="persone" size={18} />A bordo</dt><dd>Massimo {postiMassimi} persone</dd></div>
        <div><dt><Icona nome="euro" size={18} />Prezzo</dt><dd>Da {prezzoMinimo} € a persona</dd></div>
      </dl>
    </div>
  </section>

  <section id="escursioni" class="sezione sezione--calda" aria-labelledby="escursioni-titolo">
    <div class="contenitore pila">
      <div class="intestazione">
        <div class="intestazione__testo">
          <p class="occhiello">Escursioni</p>
          <h2 id="escursioni-titolo" class="titolo-sezione">Gite in barca a La Maddalena: scegli la tua</h2>
        </div>
        <p class="intestazione__lato">{regole.attive ? 'Cinque escursioni in gommone con skipper: vedi i posti liberi e prenoti online in pochi minuti.' : 'Cinque escursioni in gommone con skipper, tutte prenotabili con un messaggio WhatsApp.'}</p>
      </div>
      <SchedaEscursione e={tour} grande />
      <div class="griglia-schede">
        {altre.map((e) => <SchedaEscursione e={e} />)}
      </div>
    </div>
  </section>

  <section id="percorso" class="sezione" aria-labelledby="percorso-titolo">
    <div class="contenitore pila" style="gap:56px">
      <div class="intestazione">
        <div class="intestazione__testo">
          <p class="occhiello">Tour delle 7 isole</p>
          <h2 id="percorso-titolo" class="titolo-sezione">Il giro delle isole di La Maddalena, sosta per sosta</h2>
        </div>
        <p class="intestazione__lato">Partenza da La Maddalena alle {tour.partenze}; rientro <Dato v={tour.oraRientro} e="ora" />. L'ordine delle soste può cambiare in base a vento e mare.</p>
      </div>
      <div class="percorso">
        <Mappa />
        <div style="display:flex;flex-direction:column;gap:24px">
          <ElencoSoste programma={tour.programma} rientro={tour.oraRientro} />
          <a href="/escursioni/giro-delle-isole-la-maddalena/" class="link-freccia">Il giro delle isole in barca: programma completo<Icona nome="destra" size={18} /></a>
        </div>
      </div>
    </div>
  </section>

  <section id="mezza-giornata" class="sezione" aria-labelledby="mezza-titolo">
    <div class="contenitore pila" style="gap:56px">
      <div class="intestazione">
        <div class="intestazione__testo">
          <p class="occhiello">Mezza giornata</p>
          <h2 id="mezza-titolo" class="titolo-sezione">Escursione di mezza giornata: due giri, a seconda del vento</h2>
        </div>
        <p class="intestazione__lato">Mattina o pomeriggio, da La Maddalena (con passaggio a Palau) o da Cannigione. In tre ore e mezza si fa un giro solo: Caprera oppure le isole del nord, lo sceglie lo skipper in base al vento.</p>
      </div>
      <div class="percorso">
        <Mappa variante="mezza" didascalia="Percorsi indicativi: lo skipper sceglie il giro in base al vento." />
        <div style="display:flex;flex-direction:column;gap:24px">
          {percorsiMezza.map((p, i) => (
            <div style="display:flex;flex-direction:column;gap:12px">
              <h3 class="titolo-medio" style="font-size:24px">{p.titolo}</h3>
              <p class="testo-2" style="font-size:16px">{p.testo}</p>
              <ElencoSoste programma={p.soste} turchese={i === 1} />
            </div>
          ))}
          <a href="/escursioni/escursione-mezza-giornata-la-maddalena/" class="link-freccia">L'escursione di mezza giornata<Icona nome="destra" size={18} /></a>
        </div>
      </div>
    </div>
  </section>

  <section id="partenze" class="sezione" aria-labelledby="partenze-titolo">
    <div class="contenitore pila">
      <div class="intestazione">
        <div class="intestazione__testo">
          <p class="occhiello">Da dove si parte</p>
          <h2 id="partenze-titolo" class="titolo-sezione">Escursioni La Maddalena da Palau e da Cannigione</h2>
        </div>
        <p class="intestazione__lato">Il gommone parte dal porto di La Maddalena e passa a prendere chi si imbarca a Palau. Da Cannigione parte un gommone dedicato.</p>
      </div>
      <div class="griglia-schede">
        {partenze.map((p) => (
          <a href={p.href} class="altra">
            <span><strong>{p.titolo}</strong><span>{p.testo}</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="gommone" class="sezione" aria-labelledby="gommone-titolo">
    <div class="contenitore">
      <Gommone />
    </div>
  </section>


  <section id="info" class="sezione" aria-labelledby="info-titolo">
    <div class="contenitore pila">
      <div class="intestazione" style="gap:16px 48px">
        <div class="intestazione__testo">
          <p class="occhiello">Info utili</p>
          <h2 id="info-titolo" class="titolo-sezione">Prima di salire a bordo</h2>
        </div>
        <a href="/domande-frequenti/" class="link-freccia">Tutte le domande frequenti<Icona nome="destra" size={18} /></a>
      </div>
      <BoxInfo />
    </div>
  </section>

  <SezioneRichiesta />
</Base>
