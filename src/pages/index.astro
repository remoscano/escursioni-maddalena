---
import { regole, postiMassimi } from '../data/prenotazioni.js';
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import Icona from '../components/Icona.astro';
import Dato from '../components/Dato.astro';
import Mappa from '../components/Mappa.astro';
import ElencoSoste from '../components/ElencoSoste.astro';
import SchedaEscursione from '../components/SchedaEscursione.astro';
import Gommone from '../components/Gommone.astro';
import BoxInfo from '../components/BoxInfo.astro';
import SezioneRichiesta from '../components/SezioneRichiesta.astro';
import { escursioni, trovaEscursione } from '../data/escursioni.js';

const tour = trovaEscursione('tour-7-isole');
// I due percorsi della mezza giornata, dal programma dell'escursione (voci "percorso" seguite dalle loro soste).
const percorsiMezza: { titolo: string; testo: string; soste: any[] }[] = [];
for (const t of trovaEscursione('mezza-giornata').programma) {
  if (t.tipo === 'percorso') percorsiMezza.push({ titolo: t.titolo, testo: t.testo, soste: [] });
  else if (t.tipo === 'sosta' && percorsiMezza.length) percorsiMezza.at(-1)!.soste.push(t);
}
// Prezzo più basso a persona tra le uscite di gruppo, per l'apertura.
const prezzoMinimo = Math.min(...escursioni.filter((e) => !e.prezzoGommone).map((e) => Number(e.prezzoAdulti)));
const altre = escursioni.filter((e) => !e.inEvidenza);
---
<Base
  titolo="Escursioni Maddalena · Escursioni in maxi gommone nell'Arcipelago di La Maddalena"
  descrizione="Escursioni in maxi gommone nell'Arcipelago di La Maddalena: Tour delle 7 isole, Corsica, tramonto e tour privati. Partenza da La Maddalena, imbarco anche a Palau e Cannigione: prenoti online."

>
  <section slot="hero" class="hero" aria-label="Apertura">
    <div class="hero__griglia">
      <div class="hero__contenuto">
        <p class="hero__occhiello">Arcipelago di La Maddalena · Sardegna</p>
        <h1 class="hero__titolo">L'arcipelago di La Maddalena in maxi gommone.</h1>
        <p class="hero__testo">Il Tour delle 7 isole, la mezza giornata, il tramonto con aperitivo, il tour privato e la Corsica. Partenze da La Maddalena e Cannigione, con imbarco anche a Palau.</p>
        <div class="hero__azioni">
          {regole.attive
            ? <a href="/prenota/" class="btn btn--wa btn--grande">Prenota online</a>
            : <a href="/richiesta/" class="btn btn--wa btn--grande"><Icona nome="whatsapp" />Chiedi disponibilità su WhatsApp</a>}
          <a href="#escursioni" class="btn btn--bordo btn--grande">Scegli l'escursione<Icona nome="giu" /></a>
        </div>
      </div>
      <Foto
        class="hero__foto"
        nota="un gommone in planata tra le isole dell'arcipelago, vista dall'alto (almeno 2000 px)"
        priorita
        sizes="(max-width: 960px) 100vw, 50vw"
      />
    </div>
    <div class="hero__fatti">
      <dl>
        <div><dt><Icona nome="orologio" size={18} />Uscite</dt><dd>Mezza giornata, giornata intera, tramonto</dd></div>
        <div><dt><Icona nome="ancora" size={18} />Imbarco</dt><dd>La Maddalena, Palau, Cannigione</dd></div>
        <div><dt><Icona nome="persone" size={18} />A bordo</dt><dd>Massimo {postiMassimi} persone</dd></div>
        <div><dt><Icona nome="euro" size={18} />Prezzo</dt><dd>Da {prezzoMinimo} € a persona</dd></div>
      </dl>
    </div>
  </section>

  <section id="escursioni" class="sezione sezione--calda" aria-labelledby="escursioni-titolo">
    <div class="contenitore pila">
      <div class="intestazione">
        <div class="intestazione__testo">
          <p class="occhiello">Escursioni</p>
          <h2 id="escursioni-titolo" class="titolo-sezione">Scegli la tua giornata in mare</h2>
        </div>
        <p class="intestazione__lato">{regole.attive ? 'Cinque uscite in maxi gommone: vedi i posti liberi e prenoti online in pochi minuti.' : 'Cinque uscite in maxi gommone, tutte prenotabili con un messaggio WhatsApp.'}</p>
      </div>
      <SchedaEscursione e={tour} grande />
      <div class="griglia-schede">
        {altre.map((e) => <SchedaEscursione e={e} />)}
      </div>
    </div>
  </section>

  <section id="percorso" class="sezione" aria-labelledby="percorso-titolo">
    <div class="contenitore pila" style="gap:56px">
      <div class="intestazione">
        <div class="intestazione__testo">
          <p class="occhiello">Tour delle 7 isole</p>
          <h2 id="percorso-titolo" class="titolo-sezione">Il giro dell'arcipelago, sosta per sosta</h2>
        </div>
        <p class="intestazione__lato">Partenza da La Maddalena, con passaggio a Palau; rientro alle <Dato v={tour.oraRientro} e="ora" />. L'ordine delle soste può cambiare in base a vento e mare.</p>
      </div>
      <div class="percorso">
        <Mappa />
        <div style="display:flex;flex-direction:column;gap:24px">
          <ElencoSoste programma={tour.programma} rientro={tour.oraRientro} />
          <a href="/escursioni/tour-7-isole/" class="link-freccia">Programma completo del tour<Icona nome="destra" size={18} /></a>
        </div>
      </div>
    </div>
  </section>

  <section id="mezza-giornata" class="sezione" aria-labelledby="mezza-titolo">
    <div class="contenitore pila" style="gap:56px">
      <div class="intestazione">
        <div class="intestazione__testo">
          <p class="occhiello">Mezza giornata</p>
          <h2 id="mezza-titolo" class="titolo-sezione">Due percorsi, a seconda del vento</h2>
        </div>
        <p class="intestazione__lato">Mattina o pomeriggio, da La Maddalena (con passaggio a Palau) o da Cannigione. Con il maestrale si va sul lato riparato dell'arcipelago.</p>
      </div>
      <div class="percorso">
        <Mappa variante="mezza" didascalia="Percorsi indicativi: lo skipper sceglie in base al vento." />
        <div style="display:flex;flex-direction:column;gap:24px">
          {percorsiMezza.map((p, i) => (
            <div style="display:flex;flex-direction:column;gap:12px">
              <h3 class="titolo-medio" style="font-size:24px">{p.titolo}</h3>
              <p class="testo-2" style="font-size:16px">{p.testo}</p>
              <ElencoSoste programma={p.soste} turchese={i === 1} />
            </div>
          ))}
          <a href="/escursioni/mezza-giornata/" class="link-freccia">La mezza giornata<Icona nome="destra" size={18} /></a>
        </div>
      </div>
    </div>
  </section>

  <section id="gommone" class="sezione" aria-labelledby="gommone-titolo">
    <div class="contenitore">
      <Gommone />
    </div>
  </section>


  <section id="info" class="sezione" aria-labelledby="info-titolo">
    <div class="contenitore pila">
      <div class="intestazione" style="gap:16px 48px">
        <div class="intestazione__testo">
          <p class="occhiello">Info utili</p>
          <h2 id="info-titolo" class="titolo-sezione">Prima di salire a bordo</h2>
        </div>
        <a href="/domande-frequenti/" class="link-freccia">Tutte le domande frequenti<Icona nome="destra" size={18} /></a>
      </div>
      <BoxInfo />
    </div>
  </section>

  <SezioneRichiesta />
</Base>
