---
import Base from '../../layouts/Base.astro';
import SchedaEscursione from '../../components/SchedaEscursione.astro';
import SezioneRichiesta from '../../components/SezioneRichiesta.astro';
import { escursioni } from '../../data/escursioni.js';
import { regole } from '../../data/prenotazioni.js';
const [evidenza, ...altre] = [...escursioni].sort((a, b) => Number(!!b.inEvidenza) - Number(!!a.inEvidenza));
---
<Base
  titolo="Escursioni in maxi gommone a La Maddalena"
  descrizione="Tour delle 7 isole, Corsica con Lavezzi e Bonifacio, mezza giornata, tramonto e tour privati in maxi gommone. Partenza da La Maddalena, imbarco anche a Palau e Cannigione."
>
  <section class="testa-pagina">
    <div class="contenitore">
      <p class="occhiello">Escursioni</p>
      <h1>Scegli la tua giornata in mare</h1>
      <p class="intro">{regole.attive
        ? "Cinque uscite in maxi gommone nell'Arcipelago di La Maddalena, con partenza da La Maddalena e passaggio a Palau: vedi i posti liberi e prenoti online."
        : "Cinque uscite in maxi gommone nell'Arcipelago di La Maddalena, con partenza da La Maddalena e passaggio a Palau, prenotabili con un messaggio WhatsApp."}</p>
    </div>
  </section>
  <section class="sezione" style="padding-top:48px">
    <div class="contenitore pila">
      <SchedaEscursione e={evidenza} grande />
      <div class="griglia-schede">
        {altre.map((e) => <SchedaEscursione e={e} />)}
      </div>
    </div>
  </section>
  <SezioneRichiesta />
</Base>
