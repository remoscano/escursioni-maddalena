---
// Pagine escursione in italiano: il modello è in src/viste/Escursione.astro (lo stesso della versione inglese).
import Escursione from '../../viste/Escursione.astro';
import { escursioni } from '../../data/escursioni.js';

export function getStaticPaths() {
  return escursioni.map((e) => ({ params: { slug: e.indirizzo }, props: { e } }));
}
const { e } = Astro.props;
---
<Escursione e={e} />
