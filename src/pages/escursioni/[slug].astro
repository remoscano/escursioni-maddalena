---
// Modello unico per tutte le pagine escursione (stesso schema del Tour delle 7 isole).
import Base from '../../layouts/Base.astro';
import Foto from '../../components/Foto.astro';
import Icona from '../../components/Icona.astro';
import Dato from '../../components/Dato.astro';
import Mappa from '../../components/Mappa.astro';
import MappaRotte from '../../components/MappaRotte.astro';
import Faq from '../../components/Faq.astro';
import SezioneRichiesta from '../../components/SezioneRichiesta.astro';
import Passaggio from '../../components/Passaggio.astro';
import { escursioni, soloEsclusiva } from '../../data/escursioni.js';
import { gommoniPer, nomeGommone, postiMaxEsclusiva, gommoni } from '../../data/gommoni.js';
import { domande } from '../../data/faq.js';
import { sito } from '../../data/sito.js';

export function getStaticPaths() {
  return escursioni.map((e) => ({ params: { slug: e.slug }, props: { e } }));
}

const { e } = Astro.props;
const { imbarchi, contatti } = sito;
const altre = escursioni.filter((x) => x.slug !== e.slug);
const toni = ['acqua', 'rosa', 'acqua', 'sabbia', 'acqua'] as const;

const faqPerEscursione: Record<string, string[]> = {
  'tour-7-isole': ['maestrale', 'pranzo', 'spiaggia-rosa', 'bambini', 'pagare', 'animali'],
  'corsica-lavezzi-bonifacio': ['maestrale', 'bambini', 'pagare', 'animali'],
  'mezza-giornata': ['minimo', 'esclusiva', 'maestrale', 'bambini', 'pagare'],
  'aperitivo-tramonto': ['minimo', 'esclusiva', 'maestrale', 'bambini', 'pagare'],
  'tour-privato': ['esclusiva', 'pagare', 'maestrale', 'bambini', 'animali'],
};
faqPerEscursione['tour-7-isole'].splice(1, 0, 'minimo');
Object.values(faqPerEscursione).forEach((l) => l.splice(1, 0, 'imbarco'));
faqPerEscursione['corsica-lavezzi-bonifacio'].unshift('esclusiva');
const esclusivaSola = soloEsclusiva(e);
const gommoniPosto = gommoniPer(e.slug);
const maxEsclusiva = postiMaxEsclusiva();
const privato = gommoni.find((g) => !g.formule.includes('posto'));
const senzaOre = e.slug === 'tour-privato' || e.mappaRotte;
const durata = e.ore ? `${e.ore} ore` : '';
---
<Base
  titolo={e.titoloPagina}
  descrizione={`${e.breve} Partenza da La Maddalena, richiesta di disponibilità su WhatsApp.`.slice(0, 160)}
>
  <section class="testa-tour" aria-labelledby="tour-titolo">
    <div class="contenitore">
      <nav class="briciole" aria-label="Sei qui">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">›</li>
          <li><a href="/escursioni/">Escursioni</a></li>
          <li aria-hidden="true">›</li>
          <li aria-current="page">{e.titolo}</li>
        </ol>
      </nav>
      <div class="testa-tour__griglia">
        <div>
          <h1 id="tour-titolo">{e.titoloPagina}</h1>
          <p class="testa-tour__intro">{e.intro}</p>
          <ul class="fatti">
            <li><Icona nome="orologio" size={18} /><Dato v={e.durata} e="durata" />{e.orari !== 'da concordare' && <Fragment>, <Dato v={e.orari} e="orari" /></Fragment>}</li>
            <li><Icona nome="persone" size={18} />{esclusivaSola
              ? `Solo in esclusiva, fino a ${maxEsclusiva} persone`
              : `Da ${e.postiMin} a ${e.postiMax} persone, anche in esclusiva`}</li>
            {e.fatti.map((f: string) => <li><Icona nome="spunta" size={18} />{f}</li>)}
          </ul>
        </div>
        <aside class="box-prezzo" aria-label="Prezzo e prenotazione">
          {esclusivaSola ? (
            <Fragment>
              <p class="box-prezzo__etichetta">Gommone in esclusiva</p>
              {e.prezzoEsclusiva === 'su richiesta'
                ? <p class="box-prezzo__cifra">Su richiesta</p>
                : <p class="box-prezzo__cifra">da <Dato v={e.prezzoEsclusiva} e="PREZZO" /> €</p>}
            </Fragment>
          ) : (
            <Fragment>
              <p class="box-prezzo__etichetta">Posto singolo, a persona</p>
              <p>
                <span class="box-prezzo__cifra" style="display:block">da <Dato v={e.prezzoAdulti} e="PREZZO" /> €</span>
                {e.prezzoBambini !== null && <span class="box-prezzo__bambini">bambini <Dato v={e.prezzoBambini} e="PREZZO" /> €</span>}
              </p>
              <p class="box-prezzo__bambini">In esclusiva: {e.prezzoEsclusiva === 'su richiesta' ? 'su richiesta' : <Fragment>da <Dato v={e.prezzoEsclusiva} e="PREZZO" /> €</Fragment>}</p>
            </Fragment>
          )}
          <a href="#richiesta" class="btn btn--wa btn--grande btn--pieno"><Icona nome="whatsapp" />Chiedi disponibilità su WhatsApp</a>
          <p class="box-prezzo__nota">Nessun pagamento online. Oppure chiama {contatti.telefonoVisibile
            ? <a href={`tel:+${contatti.whatsapp}`}>{contatti.telefonoVisibile}</a>
            : <Dato e="+39 numero" />}</p>
        </aside>
      </div>
    </div>
  </section>

  <section aria-label="Galleria fotografica" style="padding-bottom:96px">
    <div class="contenitore galleria">
      <Foto nota={e.foto.galleria[0]} class="galleria__grande" priorita sizes="(max-width: 760px) 100vw, 60vw" />
      <div class="galleria__piccole">
        {e.foto.galleria.slice(1, 5).map((n: string, i: number) => (
          <Foto nota={n} tono={toni[i + 1]} sizes="(max-width: 760px) 50vw, 20vw" />
        ))}
      </div>
    </div>
  </section>

  <section id="programma" class="sezione sezione--calda" aria-labelledby="programma-titolo">
    <div class="contenitore pila">
      <div class="intestazione">
        <div class="intestazione__testo">
          <p class="occhiello">Il programma</p>
          <h2 id="programma-titolo" class="titolo-sezione">{e.mappaRotte ? 'Due rotte, scelte dal vento' : 'La giornata, ora per ora'}</h2>
        </div>
        <p class="intestazione__lato">{e.notaProgramma ?? "Orari indicativi. Con vento e mare lo skipper può cambiare l'ordine delle soste."}</p>
      </div>
      <div class={e.mappa || e.mappaRotte ? 'percorso' : 'due-colonne due-colonne--alto'}>
        <ol class="programma">
          {e.programma.map((t: any) => (
            <li class={`tappa ${t.tipo === 'rotta' ? 'tappa--rotta' : ''}`}>
              <span class="tappa__ora">{!senzaOre && <Dato v={t.ora} e="ora" />}</span>
              <span class="tappa__linea" aria-hidden="true">
                {t.tipo === 'rotta' && <span class={`tappa__punto tappa__punto--rotta tappa__punto--${t.titolo.includes('rossa') ? 'rossa' : 'gialla'}`}></span>}
                {t.tipo === 'sosta' && <span class={`tappa__punto ${t.rotta ? `tappa__punto--${t.rotta}` : ''}`}>{t.n}</span>}
                {t.tipo === 'vista' && <span class="tappa__punto tappa__punto--rosa"><Icona nome="occhio" size={18} /></span>}
                {(t.tipo === 'imbarco' || t.tipo === 'rientro') && <span class="tappa__punto tappa__punto--imbarco"><Icona nome="ancora" size={18} /></span>}
              </span>
              <div class="tappa__corpo">
                <div class="sosta__riga">
                  {t.tipo === 'rotta' ? <h3 class="tappa__rotta">{t.titolo}</h3> : <h3>{t.titolo}</h3>}
                  {t.luogo && <span class={`sosta__luogo ${t.tipo === 'vista' ? 'sosta__luogo--rosa' : ''}`}>{t.luogo}</span>}
                </div>
                <p>
                  {t.testo}
                  {t.moloDi && <Fragment> Molo: <Dato v={imbarchi[t.moloDi as 'palau'].molo} e="molo" />.</Fragment>}
                  {!t.testo && t.mancante && <Dato e={t.mancante} />}
                </p>
              </div>
            </li>
          ))}
        </ol>
        <div style="display:flex;flex-direction:column;gap:20px">
          {e.mappa && <Mappa didascalia="Percorso indicativo. Il punto rosa è la Spiaggia Rosa, che si vede solo dal mare." />}
          {e.mappaRotte && <MappaRotte />}
          <dl class="numeri">
            {e.numeri.map((n: any) => <div><dt>{n.etichetta}</dt><dd>{n.valore}</dd></div>)}
            <div><dt>Durata</dt><dd><Dato v={durata} e="ore" /></dd></div>
            <div><dt>Partenza</dt><dd>La Maddalena</dd></div>
          </dl>
          {e.note.length > 0 && (
            <ul class="note">
              {e.note.map((n: string) => <li><Icona nome="info" />{n}</li>)}
            </ul>
          )}
        </div>
      </div>
    </div>
  </section>

  <section id="pratiche" class="sezione" aria-labelledby="pratiche-titolo">
    <div class="contenitore pila">
      <div class="intestazione__testo">
        <p class="occhiello">Informazioni pratiche</p>
        <h2 id="pratiche-titolo" class="titolo-sezione">Tutto quello che serve sapere</h2>
      </div>
      <div class="griglia-info">
        <div class="box box--acqua">
          <h3>Incluso</h3>
          <ul>
            {e.incluso.map((x: string) => <li>{x}</li>)}
            {e.inclusoMancante && <li><Dato e={e.inclusoMancante} /></li>}
          </ul>
        </div>
        <div class="box">
          <h3>Non incluso</h3>
          <ul>
            {e.nonIncluso.map((x: string) => <li>{x}</li>)}
            {e.nonInclusoMancante && <li><Dato e={e.nonInclusoMancante} /></li>}
          </ul>
        </div>
        <div class="box">
          <h3>Cosa portare</h3>
          <ul>
            <li>Costume, telo e un cambio</li>
            <li>Crema solare, cappello e occhiali</li>
            <li>Acqua da bere</li>
            {e.slug === 'corsica-lavezzi-bonifacio' && <li>Carta d'identità valida per l'espatrio o passaporto</li>}
            {e.slug === 'tour-7-isole' && <li>Contanti o carta per il pranzo</li>}
          </ul>
        </div>
        <div class="box">
          <h3>Partenza da La Maddalena</h3>
          <p>Molo: <Dato v={imbarchi.maddalena.molo} e="molo e indirizzo" />.</p>
          <p>Ritrovo: <Dato v={imbarchi.maddalena.ritrovo} e="ora" />, qualche minuto prima della partenza.</p>
        </div>
        <div class="box">
          <h3>Ti passiamo a prendere</h3>
          <Passaggio />
        </div>
        <div class="box box--acqua">
          <h3>Con quale gommone</h3>
          {gommoniPosto.length > 0 && (
            <p>A posto singolo: {gommoniPosto.map((g, i) => <Fragment>{i > 0 && ' o '}<a href={`/gommoni/${g.slug}/`}>{nomeGommone(g).replace(/^Il /, 'il ')}</a></Fragment>)}, da {e.postiMin} a {e.postiMax} persone.</p>
          )}
          <p>In esclusiva: uno dei <a href="/gommoni/">tre gommoni</a>, solo per il tuo gruppo, fino a {maxEsclusiva} persone{privato && <Fragment> (fino a {privato.postiMax} con <a href={`/gommoni/${privato.slug}/`}>il gommone privato</a>)</Fragment>}.</p>
        </div>
        <div class="box">
          <h3>Regole del Parco</h3>
          <p>Siamo nel Parco Nazionale dell'Arcipelago di La Maddalena. Alla Spiaggia Rosa niente sbarco né bagno; sabbia, sassi e conchiglie restano sulle spiagge.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="faq" class="sezione sezione--calda" aria-labelledby="faq-titolo">
    <div class="contenitore due-colonne due-colonne--alto">
      <div class="intestazione__testo">
        <p class="occhiello">Domande frequenti</p>
        <h2 id="faq-titolo" class="titolo-sezione">Prima di chiederlo su WhatsApp</h2>
        <a href="/domande-frequenti/" class="link-freccia">Tutte le domande<Icona nome="destra" size={18} /></a>
      </div>
      <Faq domande={domande(faqPerEscursione[e.slug] ?? [])} />
    </div>
  </section>

  <SezioneRichiesta
    escursione={e.slug}
    titolo={`${e.titolo}: scegli la data`}
    titoloModulo={e.titolo}
    testo="Scegli data, persone e punto d'imbarco: WhatsApp si apre con il messaggio pronto e ti rispondiamo con posti e orari."
  />

  <section class="sezione" aria-labelledby="altre-titolo" style="padding:96px 0">
    <div class="contenitore pila" style="gap:32px">
      <h2 id="altre-titolo" class="titolo-medio">Altre uscite in maxi gommone</h2>
      <div class="altre">
        {altre.map((x) => (
          <a href={`/escursioni/${x.slug}/`} class="altra">
            <span class="altra__foto" aria-hidden="true"></span>
            <span><strong>{x.titolo}</strong><span>{x.breve}</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
