---
// Pagine dei punti di partenza (Palau, Cannigione), in tutte le lingue.
// Testi, orari e prezzi in src/data/imbarchi.js (e src/data/en/imbarchi.js), che li prendono da prenotazioni.js e sito.js.
import Base from '../layouts/Base.astro';
import Icona from '../components/Icona.astro';
import Dato from '../components/Dato.astro';
import Faq from '../components/Faq.astro';
import SezioneRichiesta from '../components/SezioneRichiesta.astro';
import DatiStrutturati from '../components/DatiStrutturati.astro';
import { datiLingua } from '../data/lingua.js';

interface Props { p: any }
const { p } = Astro.props;
const L = datiLingua(Astro.url);
const T = L.testi.imbarco;
const euro = L.testi.scheda.euro;
const richiesta = (slug: string) => (L.prenotaOnline ? `/prenota/?escursione=${slug}` : L.link(`/richiesta/?escursione=${slug}`));
const altre = L.pagineImbarco.filter((x: any) => x.id !== p.id);
---
<Base titolo={p.titoloSeo} descrizione={p.descrizioneSeo}>
  <DatiStrutturati slot="head" tipo="faq" domande={L.domande(p.faq)} />
  <section class="testa-tour" aria-labelledby="imbarco-titolo">
    <div class="contenitore">
      <nav class="briciole" aria-label={L.testi.escursione.seiQui}>
        <ol>
          <li><a href={L.link('/')}>Home</a></li>
          <li aria-hidden="true">›</li>
          <li><a href={L.link('/escursioni/')}>{L.testi.escursione.escursioni}</a></li>
          <li aria-hidden="true">›</li>
          <li aria-current="page">{p.briciola}</li>
        </ol>
      </nav>
      <div class="pila" style="gap:24px;max-width:820px">
        <h1 id="imbarco-titolo">{p.titoloPagina}</h1>
        <p class="testa-tour__intro">{p.intro}</p>
        <ul class="fatti">
          <li><Icona nome="ancora" size={18} />{T.imbarco}: <Dato v={p.molo.molo} e={T.moloIndirizzo} />{p.molo.mappa && <Fragment>{' · '}<a href={p.molo.mappa} target="_blank" rel="noopener">{T.apriMaps}</a></Fragment>}</li>
          <li><Icona nome="orologio" size={18} />{T.ritrovo(p.molo.ritrovo)}</li>
          {p.id === 'palau' && <li><Icona nome="auto" size={18} />{T.parcheggio}: <Dato v={p.molo.parcheggio} e={T.parcheggioSegnaposto} /></li>}
        </ul>
      </div>
    </div>
  </section>

  <section id="escursioni" class="sezione sezione--calda" aria-labelledby="elenco-titolo">
    <div class="contenitore pila">
      <div class="intestazione__testo">
        <p class="occhiello">{T.orariPrezzi}</p>
        <h2 id="elenco-titolo" class="titolo-sezione">{p.titoloElenco}</h2>
      </div>
      <div class="griglia-info">
        {p.escursioni.map(({ e, turni }: any) => (
          <article class="box">
            <h3><a href={L.urlEscursione(e.slug)}>{e.nomeLink}</a></h3>
            <p>{e.breve}</p>
            <ul>
              {turni.map((t: any) => <li><strong>{t.nome}</strong>: {t.orario}</li>)}
            </ul>
            <p><strong>{T.da(euro(e.prezzoAdulti), e.prezzoGommone)}</strong>{e.prezzoBambini !== null && <Fragment>{` · ${T.ridotto} ${euro(e.prezzoBambini)}`}</Fragment>}</p>
            <p style="display:flex;flex-wrap:wrap;gap:8px 20px">
              <a href={L.urlEscursione(e.slug)} class="link-freccia">{T.programma}<Icona nome="destra" size={18} /></a>
              <a href={richiesta(e.slug)} class="link-freccia">{L.prenotaOnline ? T.prenota : T.chiediWa}<Icona nome="destra" size={18} /></a>
            </p>
          </article>
        ))}
      </div>
      {p.nota && <p class="testo-2" style="font-size:16px;max-width:820px">{p.nota}</p>}
    </div>
  </section>

  <section class="sezione" aria-labelledby="perche-titolo">
    <div class="contenitore pila">
      <h2 id="perche-titolo" class="titolo-sezione">{p.perche.titolo}</h2>
      <ul class="note">
        {p.perche.punti.map((x: string) => <li><Icona nome="spunta" />{x}</li>)}
      </ul>
      {altre.map((x: any) => <a href={x.href} class="link-freccia">{x.titoloPagina}<Icona nome="destra" size={18} /></a>)}
    </div>
  </section>

  <section id="faq" class="sezione sezione--calda" aria-labelledby="faq-titolo">
    <div class="contenitore due-colonne due-colonne--alto">
      <div class="intestazione__testo">
        <p class="occhiello">{L.testi.escursione.faq.occhiello}</p>
        <h2 id="faq-titolo" class="titolo-sezione">{p.titoloDomande}</h2>
        <a href={L.link('/domande-frequenti/')} class="link-freccia">{L.testi.escursione.faq.tutte}<Icona nome="destra" size={18} /></a>
      </div>
      <Faq domande={L.domande(p.faq)} />
    </div>
  </section>

  <SezioneRichiesta imbarco={p.imbarco} titolo={p.titoloRichiesta} />
</Base>
