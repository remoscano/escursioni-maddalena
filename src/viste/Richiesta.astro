---
// Richiesta di disponibilità su WhatsApp, in tutte le lingue (src/pages/richiesta.astro e src/pages/en/enquiry.astro).
import Base from '../layouts/Base.astro';
import ModuloRichiesta from '../components/ModuloRichiesta.astro';
import Dato from '../components/Dato.astro';
import { datiLingua } from '../data/lingua.js';
const L = datiLingua(Astro.url);
const { sito } = L;
const T = L.testi.richiesta;
const { contatti } = sito;
---
<Base titolo={T.titolo} descrizione={T.descrizione}>
  <section class="testa-pagina" style="padding-bottom:0">
    <div class="contenitore" style="max-width:760px">
      <p class="occhiello">{T.occhiello}</p>
      <h1>{T.h1}</h1>
      <p class="intro">{T.intro}{L.prenotaOnline
        ? <Fragment> Per prenotare e pagare subito, senza aspettare la risposta: <a href="/prenota/">prenota online</a>.</Fragment>
        : ` ${sito.pagamentoLink.breve}.`}</p>
    </div>
  </section>
  <section class="sezione" style="padding-top:40px">
    <div class="contenitore" style="max-width:760px;display:flex;flex-direction:column;gap:24px">
      <h2 class="sr-only">{T.modulo}</h2>
      <ModuloRichiesta chiaro titolo={T.titoloModulo} />
      <p class="testo-2" style="text-align:center;font-size:16px">
        {T.chiamare} {contatti.telefonoVisibile
          ? <a href={`tel:+${contatti.whatsapp}`} style="font-weight:700">{contatti.telefonoVisibile}</a>
          : <Dato e="+39 numero" />}
      </p>
    </div>
  </section>
</Base>
