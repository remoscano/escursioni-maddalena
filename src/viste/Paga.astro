---
// Link di pagamento mandato dalla gestione, in tutte le lingue: il cliente vede il riepilogo e paga con carta o PayPal.
// /prenota/paga/, /en/book/pay/ ... (src/data/percorsi.js). Testi in esito-testi.js (paga) e prenota-testi.js.
import Base from '../layouts/Base.astro';
import { datiLingua } from '../data/lingua.js';
import { percorsiPrenota } from '../data/percorsi.js';
import { testiEsitoDi } from '../data/esito-testi.js';
const L = datiLingua(Astro.url);
const E = testiEsitoDi(L.lingua).paga;
const config = { lingua: L.lingua, percorsi: percorsiPrenota[L.lingua], privacy: L.link('/privacy/') };
---
<Base titolo={E.titolo} descrizione={E.descrizione} nascosta senzaBarra>
  <section class="sezione" style="padding-top:56px">
    <div class="contenitore" style="max-width:760px">
      <div class="esito" data-paga-link data-whatsapp={L.sito.contatti.whatsapp} data-config={JSON.stringify(config)}>
        <p class="testo-2">{E.carico}</p>
      </div>
    </div>
  </section>
</Base>

<style is:global>
  .esito { background: var(--bianco); border: 1px solid var(--bordo); border-radius: var(--raggio-l); padding: 40px; display: flex; flex-direction: column; gap: 20px; box-shadow: var(--ombra-grande); }
  @media (max-width: 520px) { .esito { padding: 28px 20px; } }
  .esito h1 { font-weight: 800; font-size: clamp(32px, 4.4vw, 48px); line-height: 1.05; letter-spacing: -0.02em; }
  .esito__codice { display: inline-flex; align-self: flex-start; background: var(--acqua); border-radius: 999px; padding: 6px 14px; font-weight: 800; letter-spacing: .06em; }
  .esito dl { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 8px 20px; font-size: 16px; }
  .esito dt { color: var(--testo-2); }
  .esito dd { margin: 0; font-weight: 600; }
  .paga__accetto { display: flex; gap: 10px; align-items: flex-start; font-size: 15px; line-height: 1.5; cursor: pointer; }
  .paga__accetto input { width: 20px; height: 20px; margin-top: 2px; accent-color: var(--mare); flex: none; }
  .paga__bottoni { display: flex; flex-direction: column; gap: 10px; max-width: 420px; }
</style>

<script>
  import { api, h } from '../scripts/comune';
  import { regole } from '../data/prenotazioni.js';
  import { testiPrenotaDi } from '../data/prenota-testi.js';
  import { testiEsitoDi } from '../data/esito-testi.js';
  const box = document.querySelector<HTMLElement>('[data-paga-link]')!;
  const config = JSON.parse(box.dataset.config || '{}');
  const T: any = testiPrenotaDi(config.lingua);
  const ES: any = testiEsitoDi(config.lingua);
  const E = ES.paga;
  const P = config.percorsi;
  const euro = (n: number) => T.euro(n);
  const persone = (a: number, b = 0, n = 0) => T.persone(a, (Number(b) || 0) + (Number(n) || 0));
  const q = new URLSearchParams(location.search);
  const codice = q.get('codice') || '', t = q.get('t') || '';
  const whatsapp = box.dataset.whatsapp || '';
  const wa = (testo: string) => whatsapp ? `<a class="btn btn--bordo" href="https://wa.me/${h(whatsapp)}?text=${encodeURIComponent(testo)}">${h(ES.scrivici)}</a>` : '';
  const ETICHETTE: Record<string, string> = T.paga;
  const esito = `${P.esito}?codice=${encodeURIComponent(codice)}&t=${encodeURIComponent(t)}`;

  async function carica() {
    let p: any;
    try { p = await api(`/api/prenotazione?codice=${encodeURIComponent(codice)}&t=${encodeURIComponent(t)}`); }
    catch (e) { box.innerHTML = `<h1>${h(ES.nonTrovata)}</h1><p>${h((e as Error).message)}</p><div>${wa(E.waLink)}</div>`; return; }
    if (!p.pagabile) {
      box.innerHTML = p.stato === 'confermata' && p.daPagare === 0
        ? `<p class="esito__codice">${h(p.codice)}</p><h1>${h(E.giaPagata)}</h1><p>${h(E.giaPagataTesto)}</p><div><a class="btn btn--wa" href="${esito}">${h(E.vedi)}</a></div>`
        : `<p class="esito__codice">${h(p.codice)}</p><h1>${h(E.scaduto)}</h1><p>${h(E.scadutoTesto)}</p><div>${wa(E.waScaduto(p.codice))}</div>`;
      return;
    }
    const scade = p.stato === 'in_attesa' && p.scadeIl ? new Intl.DateTimeFormat(T.locale, { weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Rome' }).format(new Date(p.scadeIl)) : '';
    box.innerHTML = `<p class="esito__codice">${h(p.codice)}</p>
      <h1>${h(E.titolo)}</h1>
      <p>${h(E.ciao(p.nome))} ${scade ? h(E.fino(scade)) : ''}</p>
      <dl>
        <dt>${h(ES.r.escursione)}</dt><dd>${h(p.escursione)}</dd>
        <dt>${h(ES.r.data)}</dt><dd>${h(p.dataLeggibile)}</dd>
        <dt>${h(ES.r.orario)}</dt><dd>${h(p.turno)}${p.orario ? ` · ${h(p.orario)}` : ''}</dd>
        <dt>${h(ES.r.imbarco)}</dt><dd>${h(p.imbarco)}</dd>
        <dt>${h(ES.r.persone)}</dt><dd>${h(persone(p.adulti, p.bambini, p.neonati))}</dd>
        <dt>${h(ES.r.daPagare)}</dt><dd style="font-size:22px;font-weight:800">${euro(p.daPagare)}</dd>
      </dl>
      ${p.carburanteEscluso && p.carburante ? `<p class="testo-2">${h(T.info.carburante(p.carburante))}</p>` : ''}
      <p class="testo-2">${h(T.info.cancellazione(regole.cancellazioneGratisOre))}</p>
      <label class="paga__accetto"><input type="checkbox" data-accetto /><span>${h(T.accettoPrima)}<a href="${P.condizioni}" target="_blank" rel="noopener">${h(T.condizioni)}</a>${h(T.accettoMezzo)}<a href="${config.privacy}" target="_blank" rel="noopener">${h(T.privacy)}</a>${h(T.accettoDopo)}</span></label>
      <p class="avviso" data-errore hidden role="alert"></p>
      <div class="paga__bottoni">${(p.pagamenti || []).map((m: string, i: number) => `<button type="button" class="btn ${i === 0 ? 'btn--wa' : 'btn--scuro'} btn--grande btn--pieno" data-metodo="${h(m)}">${h(ETICHETTE[m] || m)}</button>`).join('') || `<p class="avviso">${h(E.spenti)}</p>`}</div>
      <p class="testo-2" style="font-size:13px">${h(T.sicuro)}</p>`;
    box.querySelector('.paga__bottoni')!.addEventListener('click', async (ev) => {
      const b = (ev.target as Element).closest<HTMLButtonElement>('[data-metodo]');
      if (!b) return;
      const err = box.querySelector<HTMLElement>('[data-errore]')!;
      err.hidden = true;
      if (!box.querySelector<HTMLInputElement>('[data-accetto]')!.checked) { err.textContent = E.spunta; err.hidden = false; return; }
      b.disabled = true;
      try { const r = await api('/api/pagamento/avvia', { corpo: { codice, t, metodo: b.dataset.metodo, accetto: true } }); location.assign(r.redirect); }
      catch (e) { b.disabled = false; err.textContent = (e as Error).message; err.hidden = false; }
    });
  }
  carica();
</script>
