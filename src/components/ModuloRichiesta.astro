---
// Mini-modulo che apre WhatsApp con il messaggio già scritto.
// Nessun dato passa dal sito: il testo viene composto nel browser e aperto in WhatsApp.
import Icona from './Icona.astro';
import { escursioni, soloEsclusiva } from '../data/escursioni.js';
import { gommoni, trovaGommone, nomeGommone } from '../data/gommoni.js';
import { sito } from '../data/sito.js';

interface Props {
  escursione?: string;   // slug: se presente, l'escursione è già scelta e il menu non compare
  gommone?: string;      // slug: se presente, la richiesta è per quel gommone
  titolo?: string;
  chiaro?: boolean;      // stile per sfondo chiaro
  id?: string;
}
const { escursione, gommone, titolo = 'Richiesta di disponibilità', chiaro = false, id = 'modulo' } = Astro.props;
const fissa = escursione ? escursioni.find((e) => e.slug === escursione) : undefined;
const g = gommone ? trovaGommone(gommone) : undefined;
// Il posto singolo si può chiedere solo se l'escursione lo prevede
// e, se il gommone è già scelto, solo per le uscite che quel gommone fa a posto singolo.
const postoPossibile = (e: any) => !soloEsclusiva(e) && (!g || g.escursioni.includes(e.slug));
const imbarchiDi = (e: any): string[] => e.imbarchi ?? ['palau', 'maddalena'];
const tuttiImbarchi = ['palau', 'maddalena', 'cannigione'];
const imbarchiMostrati = fissa ? imbarchiDi(fissa) : tuttiImbarchi;
const nomiGommoni = Object.fromEntries(gommoni.map((x) => [x.slug, nomeGommone(x)]));
---
<form
  class={`modulo ${chiaro ? 'modulo--chiaro' : ''}`}
  data-modulo-wa
  data-numero={sito.contatti.whatsapp}
  data-nome-sito={sito.nome}
  data-gommoni={JSON.stringify(nomiGommoni)}
  aria-labelledby={`${id}-titolo`}
  novalidate
>
  <h3 id={`${id}-titolo`}>{titolo}</h3>

  <input type="hidden" name="gommone" value={g ? nomeGommone(g) : ''} />

  {fissa ? (
    <input type="hidden" name="escursione" value={fissa.titolo} data-posto={postoPossibile(fissa) ? '1' : '0'} data-imbarchi={imbarchiDi(fissa).join(' ')} />
  ) : (
    <div class="campo">
      <label for={`${id}-escursione`}>Escursione</label>
      <select id={`${id}-escursione`} name="escursione">
        {escursioni.map((e) => <option value={e.titolo} data-slug={e.slug} data-posto={postoPossibile(e) ? '1' : '0'} data-imbarchi={imbarchiDi(e).join(' ')}>{e.titolo}</option>)}
      </select>
    </div>
  )}

  <fieldset data-formula>
    <legend>Formula</legend>
    <div class="scelte">
      <label class="scelta"><input type="radio" name="formula" value="posto singolo" checked />Posto singolo</label>
      <label class="scelta"><input type="radio" name="formula" value="gommone in esclusiva" />In esclusiva</label>
    </div>
    <p class="modulo__aiuto" data-formula-nota hidden>Questa proposta si fa solo con il gommone in esclusiva.</p>
  </fieldset>

  <div class="campi-3">
    <div class="campo">
      <label for={`${id}-data`}>Data</label>
      <input id={`${id}-data`} name="data" type="date" />
    </div>
    <div class="campo">
      <label for={`${id}-adulti`}>Adulti</label>
      <input id={`${id}-adulti`} name="adulti" type="number" inputmode="numeric" min="1" max="99" value="2" />
    </div>
    <div class="campo">
      <label for={`${id}-bambini`}>Bambini</label>
      <input id={`${id}-bambini`} name="bambini" type="number" inputmode="numeric" min="0" max="99" value="0" />
    </div>
  </div>

  <fieldset>
    <legend>Imbarco</legend>
    <div class="scelte scelte--imbarco">
      {imbarchiMostrati.map((k, i) => (
        <label class="scelta" data-imbarco={k}><input type="radio" name="imbarco" value={sito.imbarchi[k as 'palau'].nome} checked={i === 0} />{sito.imbarchi[k as 'palau'].nome}</label>
      ))}
    </div>
  </fieldset>

  <div class="campo">
    <label for={`${id}-nome`}>Nome</label>
    <input id={`${id}-nome`} name="nome" type="text" autocomplete="given-name" placeholder="Come ti chiami?" />
  </div>

  <div class="anteprima">
    <p class="anteprima__titolo"><Icona nome="whatsapp" size={16} />Il messaggio che arriverà</p>
    <div class="anteprima__messaggio" data-anteprima aria-live="polite"></div>
  </div>

  <p class="avviso" data-avviso hidden></p>

  <button type="submit" class="btn btn--wa btn--grande btn--pieno"><Icona nome="whatsapp" />Apri WhatsApp con il messaggio pronto</button>
  <p class="modulo__nota">Controlli il testo e premi Invia: nessun pagamento online. <a href="/privacy/">Privacy</a></p>
</form>

<script>
  const formatoData = new Intl.DateTimeFormat('it-IT', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });

  document.querySelectorAll<HTMLFormElement>('form[data-modulo-wa]').forEach((form) => {
    const anteprima = form.querySelector<HTMLElement>('[data-anteprima]')!;
    const avviso = form.querySelector<HTMLElement>('[data-avviso]')!;
    const nomeSito = form.dataset.nomeSito ?? '';
    const campoData = form.querySelector<HTMLInputElement>('input[name="data"]');
    const select = form.querySelector<HTMLSelectElement>('select[name="escursione"]');
    const fissa = form.querySelector<HTMLInputElement>('input[type="hidden"][name="escursione"]');
    const radioPosto = form.querySelector<HTMLInputElement>('input[name="formula"][value="posto singolo"]')!;
    const radioEsclusiva = form.querySelector<HTMLInputElement>('input[name="formula"][value="gommone in esclusiva"]')!;
    const notaFormula = form.querySelector<HTMLElement>('[data-formula-nota]')!;
    const campoGommone = form.querySelector<HTMLInputElement>('input[name="gommone"]')!;
    const parametri = new URLSearchParams(location.search);

    // /richiesta/?gommone=slug e ?formula=esclusiva
    const nomiGommoni = JSON.parse(form.dataset.gommoni ?? '{}') as Record<string, string>;
    const slugGommone = parametri.get('gommone');
    if (!campoGommone.value && slugGommone && nomiGommoni[slugGommone]) campoGommone.value = nomiGommoni[slugGommone];
    if (parametri.get('formula') === 'esclusiva') radioEsclusiva.checked = true;

    // Se l'escursione scelta non prevede il posto singolo, resta solo l'esclusiva
    const aggiornaFormula = () => {
      const scelta = select ? select.selectedOptions[0] : fissa;
      const posto = scelta?.dataset.posto === '1';
      radioPosto.disabled = !posto;
      radioPosto.closest('label')!.toggleAttribute('data-spenta', !posto);
      if (!posto) radioEsclusiva.checked = true;
      notaFormula.hidden = posto;
      // Punti d'imbarco previsti dall'escursione: gli altri si nascondono
      const ammessi = (scelta?.dataset.imbarchi ?? '').split(' ').filter(Boolean);
      const etichette = [...form.querySelectorAll<HTMLLabelElement>('[data-imbarco]')];
      etichette.forEach((l) => { l.hidden = ammessi.length > 0 && !ammessi.includes(l.dataset.imbarco!); });
      const visibili = etichette.filter((l) => !l.hidden);
      // il primo punto previsto è quello principale
      const ordinate = ammessi.length ? ammessi.map((k) => visibili.find((l) => l.dataset.imbarco === k)!).filter(Boolean) : visibili;
      if (!visibili.some((l) => l.querySelector('input')!.checked) || select) {
        const prima = ordinate[0]?.querySelector('input');
        if (prima) prima.checked = true;
      }
    };

    // Niente date passate
    if (campoData) {
      const oggi = new Date();
      oggi.setMinutes(oggi.getMinutes() - oggi.getTimezoneOffset());
      campoData.min = oggi.toISOString().slice(0, 10);
    }

    // /richiesta/?escursione=slug preseleziona l'escursione
    if (select) {
      const slug = new URLSearchParams(location.search).get('escursione');
      const opzione = slug ? select.querySelector<HTMLOptionElement>(`option[data-slug="${CSS.escape(slug)}"]`) : null;
      if (opzione) opzione.selected = true;
    }
    aggiornaFormula();
    select?.addEventListener('change', aggiornaFormula);

    const intero = (nome: string, minimo: number) => {
      const v = parseInt((form.elements.namedItem(nome) as HTMLInputElement)?.value ?? '', 10);
      return Number.isFinite(v) ? Math.min(99, Math.max(minimo, v)) : minimo;
    };

    const messaggio = () => {
      const dati = new FormData(form);
      const escursione = String(dati.get('escursione') ?? '');
      const valoreData = String(dati.get('data') ?? '');
      let testoData = 'da concordare';
      if (valoreData) {
        const d = new Date(valoreData + 'T12:00:00');
        if (!isNaN(d.getTime())) testoData = formatoData.format(d);
      }
      const adulti = intero('adulti', 1);
      const bambini = intero('bambini', 0);
      const persone = `${adulti} ${adulti === 1 ? 'adulto' : 'adulti'}` +
        (bambini > 0 ? `, ${bambini} ${bambini === 1 ? 'bambino' : 'bambini'}` : '');
      const nome = String(dati.get('nome') ?? '').trim();
      const gommone = String(dati.get('gommone') ?? '');
      return [
        `Ciao ${nomeSito}! Vorrei prenotare:`,
        `• ${escursione}`,
        `• Formula: ${dati.get('formula')}`,
        ...(gommone ? [`• Gommone: ${gommone}`] : []),
        `• Data: ${testoData}`,
        `• Persone: ${persone}`,
        `• Imbarco: ${dati.get('imbarco')}`,
        nome ? `Sono ${nome}, grazie!` : 'Grazie!',
      ].join('\n');
    };

    const aggiorna = () => { anteprima.textContent = messaggio(); };
    form.addEventListener('input', aggiorna);
    form.addEventListener('change', aggiorna);
    aggiorna();

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const numero = (form.dataset.numero ?? '').replace(/\D/g, '');
      if (!numero) {
        avviso.hidden = false;
        avviso.textContent = 'Il numero WhatsApp non è ancora stato inserito nel sito (src/data/sito.js).';
        return;
      }
      avviso.hidden = true;
      const url = `https://wa.me/${numero}?text=${encodeURIComponent(messaggio())}`;
      window.location.href = url;
    });
  });
</script>
