---
// Mini-modulo che apre WhatsApp con il messaggio già scritto.
// Nessun dato passa dal sito: il testo viene composto nel browser e aperto in WhatsApp.
import Icona from './Icona.astro';
import { datiLingua } from '../data/lingua.js';

interface Props {
  escursione?: string;   // slug: se presente, l'escursione è già scelta e il menu non compare
  titolo?: string;
  chiaro?: boolean;      // stile per sfondo chiaro
  id?: string;
  imbarco?: string;      // 'La Maddalena' | 'Palau' | 'Cannigione': punto d'imbarco già scelto
}
const L = datiLingua(Astro.url);
const { escursioni, sito } = L;
const T = L.testi.modulo;
const { escursione, titolo = T.titolo, chiaro = false, id = 'modulo', imbarco = 'La Maddalena' } = Astro.props;
const fissa = escursione ? escursioni.find((e: any) => e.slug === escursione) : undefined;
// Testi del messaggio WhatsApp, letti dallo script qui sotto.
const messaggio = { ...T.messaggio, locale: T.locale };
---
<form
  class={`modulo ${chiaro ? 'modulo--chiaro' : ''}`}
  data-modulo-wa
  data-numero={sito.contatti.whatsapp}
  data-nome-sito={sito.nome}
  data-testi={JSON.stringify(messaggio)}
  aria-labelledby={`${id}-titolo`}
  novalidate
>
  <h3 id={`${id}-titolo`}>{titolo}</h3>

  {fissa ? (
    <input type="hidden" name="escursione" value={fissa.titolo} />
  ) : (
    <div class="campo">
      <label for={`${id}-escursione`}>{T.escursione}</label>
      <select id={`${id}-escursione`} name="escursione">
        {escursioni.map((e: any) => <option value={e.titolo} data-slug={e.slug}>{e.titolo}</option>)}
      </select>
    </div>
  )}

  <div class="campi-3">
    <div class="campo">
      <label for={`${id}-data`}>{T.data}</label>
      <input id={`${id}-data`} name="data" type="date" />
    </div>
    <div class="campo">
      <label for={`${id}-adulti`}>{T.adulti}</label>
      <input id={`${id}-adulti`} name="adulti" type="number" inputmode="numeric" min="1" max="99" value="2" />
    </div>
    <div class="campo">
      <label for={`${id}-bambini`}>{T.bambini}</label>
      <input id={`${id}-bambini`} name="bambini" type="number" inputmode="numeric" min="0" max="99" value="0" />
    </div>
  </div>

  <fieldset>
    <legend>{T.imbarco}</legend>
    <div class="scelte">
      <label class="scelta"><input type="radio" name="imbarco" value="La Maddalena" checked={imbarco === 'La Maddalena'} />La Maddalena</label>
      <label class="scelta"><input type="radio" name="imbarco" value="Palau" checked={imbarco === 'Palau'} />Palau</label>
      <label class="scelta"><input type="radio" name="imbarco" value="Cannigione" checked={imbarco === 'Cannigione'} />Cannigione</label>
    </div>
  </fieldset>

  <div class="campo">
    <label for={`${id}-nome`}>{T.nome}</label>
    <input id={`${id}-nome`} name="nome" type="text" autocomplete="given-name" placeholder={T.nomeSegnaposto} />
  </div>

  <div class="anteprima">
    <p class="anteprima__titolo"><Icona nome="whatsapp" size={16} />{T.anteprima}</p>
    <div class="anteprima__messaggio" data-anteprima aria-live="polite"></div>
  </div>

  <p class="avviso" data-avviso hidden></p>

  <button type="submit" class="btn btn--wa btn--grande btn--pieno"><Icona nome="whatsapp" />{T.invia}</button>
  <p class="modulo__nota">{T.nota} {sito.pagamentoLink.breve}. <a href={L.link('/privacy/')}>Privacy</a></p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-modulo-wa]').forEach((form) => {
    const t = JSON.parse(form.dataset.testi ?? '{}');
    const formatoData = new Intl.DateTimeFormat(t.locale, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
    const anteprima = form.querySelector<HTMLElement>('[data-anteprima]')!;
    const avviso = form.querySelector<HTMLElement>('[data-avviso]')!;
    const nomeSito = form.dataset.nomeSito ?? '';
    const campoData = form.querySelector<HTMLInputElement>('input[name="data"]');
    const select = form.querySelector<HTMLSelectElement>('select[name="escursione"]');

    // Niente date passate
    if (campoData) {
      const oggi = new Date();
      oggi.setMinutes(oggi.getMinutes() - oggi.getTimezoneOffset());
      campoData.min = oggi.toISOString().slice(0, 10);
    }

    // /richiesta/?escursione=slug preseleziona l'escursione
    if (select) {
      const slug = new URLSearchParams(location.search).get('escursione');
      const opzione = slug ? select.querySelector<HTMLOptionElement>(`option[data-slug="${CSS.escape(slug)}"]`) : null;
      if (opzione) opzione.selected = true;
    }

    const intero = (nome: string, minimo: number) => {
      const v = parseInt((form.elements.namedItem(nome) as HTMLInputElement)?.value ?? '', 10);
      return Number.isFinite(v) ? Math.min(99, Math.max(minimo, v)) : minimo;
    };

    const messaggio = () => {
      const dati = new FormData(form);
      const escursione = String(dati.get('escursione') ?? '');
      const valoreData = String(dati.get('data') ?? '');
      let testoData = t.daConcordare;
      if (valoreData) {
        const d = new Date(valoreData + 'T12:00:00');
        if (!isNaN(d.getTime())) testoData = formatoData.format(d);
      }
      const adulti = intero('adulti', 1);
      const bambini = intero('bambini', 0);
      const persone = `${adulti} ${adulti === 1 ? t.adulto : t.adulti}` +
        (bambini > 0 ? `, ${bambini} ${bambini === 1 ? t.bambino : t.bambini}` : '');
      const nome = String(dati.get('nome') ?? '').trim();
      return [
        t.saluto.replace('{nome}', nomeSito),
        `• ${escursione}`,
        `• ${t.data}: ${testoData}`,
        `• ${t.persone}: ${persone}`,
        `• ${t.imbarco}: ${dati.get('imbarco')}`,
        nome ? t.firma.replace('{nome}', nome) : t.grazie,
      ].join('\n');
    };

    const aggiorna = () => { anteprima.textContent = messaggio(); };
    form.addEventListener('input', aggiorna);
    form.addEventListener('change', aggiorna);
    aggiorna();

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const numero = (form.dataset.numero ?? '').replace(/\D/g, '');
      if (!numero) {
        avviso.hidden = false;
        avviso.textContent = t.senzaNumero;
        return;
      }
      avviso.hidden = true;
      const url = `https://wa.me/${numero}?text=${encodeURIComponent(messaggio())}`;
      window.location.href = url;
    });
  });
</script>
