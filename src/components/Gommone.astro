---
// Blocco "I gommoni" della home: i tre mezzi con il link alle loro pagine.
import SchedaGommone from './SchedaGommone.astro';
import Icona from './Icona.astro';
import { gommoni } from '../data/gommoni.js';
---
<div class="pila">
  <div class="intestazione">
    <div class="intestazione__testo">
      <p class="occhiello">I gommoni</p>
      <h2 id="gommone-titolo" class="titolo-sezione">Tre maxi gommoni, ognuno con il suo giro</h2>
    </div>
    <p class="intestazione__lato">Puoi prenotare un posto a bordo o avere il gommone solo per il tuo gruppo. <a href="/gommoni/" class="link-freccia" style="display:inline-flex">Come funziona<Icona nome="destra" size={18} /></a></p>
  </div>
  <div class="griglia-schede">
    {gommoni.map((g) => <SchedaGommone g={g} />)}
  </div>
</div>
