---
import Foto from './Foto.astro';
import Dato from './Dato.astro';
import Icona from './Icona.astro';
import { datiLingua } from '../data/lingua.js';
import { gommoni } from '../data/prenotazioni.js';
import { foto } from '../data/foto.js';
interface Props { titoloLivello?: 'h1' | 'h2'; link?: boolean }
const { titoloLivello = 'h2', link = true } = Astro.props;
const L = datiLingua(Astro.url);
const T = L.testi.gommone;
const { gommone, flotta } = L.sito;
const posti = (id: string) => gommoni.find((g) => g.id === id)?.posti;
const uso = (id: string) => {
  const g = gommoni.find((x) => x.id === id);
  if (g?.imbarchi.includes('cannigione')) return T.usoCannigione;
  return g?.tipo === 'esclusiva' ? T.usoEsclusive : T.usoGruppo;
};
const Titolo = titoloLivello;
---
<div class="due-colonne">
  <Foto nota={T.foto} src={foto('home/gommoni')} class="gommone__foto" />
  <div style="display:flex;flex-direction:column;gap:28px">
    <div style="display:flex;flex-direction:column;gap:16px">
      <p class="occhiello">{T.occhiello}</p>
      <Titolo id="gommone-titolo" class="titolo-sezione">{T.titolo}</Titolo>
      <p class="testo-2"><Dato v={gommone.descrizione} e="Presenta i gommoni in due righe: comodità, perché sono adatti a famiglie e gruppi" /></p>
    </div>
    <dl class="dati-barca">
      {flotta.map((g) => (
        <div>
          <dt>{uso(g.id)}</dt>
          <dd>{g.modello}</dd>
          <dd class="testo">{[T.finoA(posti(g.id)), g.motori, g.dotazioni].filter(Boolean).join(' · ')}</dd>
        </div>
      ))}
    </dl>
    {link && <a href={L.link('/gommone/')} class="link-freccia">{T.scopri}<Icona nome="destra" size={18} /></a>}
  </div>
</div>

<style>
  :global(.gommone__foto) { aspect-ratio: 5 / 4; }
</style>
