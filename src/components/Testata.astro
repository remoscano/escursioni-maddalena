---
import { regole } from '../data/prenotazioni.js';
import Logo from './Logo.astro';
import Icona from './Icona.astro';
import { menu } from '../data/menu.js';

interface Props { scura?: boolean }
const { scura = false } = Astro.props;
const percorso = Astro.url.pathname;
const attivo = (href: string) =>
  href === '/escursioni/' ? percorso === href : percorso.startsWith(href);
---
<header class={`testata ${scura ? 'testata--scura su-scuro' : 'testata--chiara'}`}>
  <div class="testata__barra">
    <Logo />
    <nav class="testata__menu" aria-label="Menu principale">
      {menu.map((v) => (
        <a href={v.href} aria-current={attivo(v.href) ? 'page' : undefined}>{v.testo}</a>
      ))}
    </nav>
    <div class="testata__azioni">
      {regole.attive
        ? <a href="/prenota/" class="btn btn--wa">Prenota online</a>
        : <a href="/richiesta/" class="btn btn--wa"><Icona nome="whatsapp" />Scrivici su WhatsApp</a>}
      <button type="button" class="testata__apri" aria-expanded="false" aria-controls="menu-telefono" data-apri-menu>
        <span class="sr-only">Apri il menu</span>
        <Icona nome="menu" size={22} />
      </button>
    </div>
  </div>
  <div class="testata__pannello" id="menu-telefono" hidden>
    <nav aria-label="Menu">
      <a href="/">Home</a>
      {menu.map((v) => (
        <a href={v.href} aria-current={attivo(v.href) ? 'page' : undefined}>{v.testo}</a>
      ))}
      {regole.attive && <a href="/prenota/" class="btn btn--wa btn--grande">Prenota online</a>}
      <a href="/richiesta/" class={`btn btn--grande ${regole.attive ? 'btn--bordo' : 'btn--wa'}`}><Icona nome="whatsapp" />{regole.attive ? 'Scrivici su WhatsApp' : 'Chiedi disponibilità'}</a>
    </nav>
  </div>
</header>

<script>
  const bottone = document.querySelector<HTMLButtonElement>('[data-apri-menu]');
  const pannello = document.getElementById('menu-telefono');
  if (bottone && pannello) {
    const etichetta = bottone.querySelector('.sr-only');
    const imposta = (aperto: boolean) => {
      pannello.hidden = !aperto;
      bottone.setAttribute('aria-expanded', String(aperto));
      if (etichetta) etichetta.textContent = aperto ? 'Chiudi il menu' : 'Apri il menu';
    };
    bottone.addEventListener('click', () => imposta(pannello.hidden));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !pannello.hidden) { imposta(false); bottone.focus(); }
    });
  }
</script>
