---
// Mappa illustrata dell'arcipelago: percorso del Tour delle 7 isole (variante '7isole')
// o i due percorsi della mezza giornata (variante 'mezza', dalla mappa del cliente, 11 novembre 2026).
// Le posizioni sono in percentuale sull'immagine (1000 × 1076).
import Icona from './Icona.astro';
interface Props { didascalia?: string; variante?: '7isole' | 'mezza' }
const { didascalia = 'Percorso indicativo: lo skipper lo adatta a vento e mare.', variante = '7isole' } = Astro.props;
const mezza = variante === 'mezza';

const isole = [
  { nome: 'La Maddalena', x: 50.99, y: 50.91 },
  { nome: 'Caprera', x: 83.62, y: 68.24 },
  { nome: 'Santo<br>Stefano', x: 52.74, y: 75.01 },
  { nome: 'Spargi', x: 21.85, y: 48.2 },
  { nome: 'Budelli', x: 19.52, y: 24.64 },
  { nome: 'Razzoli', x: 16.61, y: 11.1 },
  { nome: 'Santa<br>Maria', x: 35.26, y: 12.19 },
  { nome: 'Palau', x: 37, y: 88 },
  { nome: 'Sardegna', x: 15.15, y: 94.23 },
];
// La Maddalena è il porto di partenza; a Palau il gommone passa a prendere i clienti (Remo, 11 novembre 2026).
const partenza = { x: 58.5, y: 67.75 };
const passaggioPalau = { x: 41.38, y: 82.52 };
const soste7 = [
  { n: '1', x: 51.86, y: 82.31 },
  { n: '2', x: 71.08, y: 58.38 },
  { n: '3', x: 52.35, y: 66.17 },
  { n: '4', x: 25.31, y: 54.63 },
  { n: '5', x: 25.06, y: 18.68 },
  { n: '6', x: 35.12, y: 20.06 },
];
// Mezza giornata: blu = giro di Caprera, turchese = con il maestrale (Spargi e La Maddalena). I Giardinelli in tutti e due.
const sosteMezza = [
  { n: '1', x: 92.2, y: 55.6 },
  { n: '2', x: 79, y: 42 },
  { n: '3', x: 67.8, y: 62.8, largo: true },
  { n: '1', x: 25.3, y: 54.8, turchese: true },
  { n: '2', x: 52.3, y: 67.7, turchese: true },
];
const soste = mezza ? sosteMezza : soste7;
const immagine = mezza ? '/img/mappa-mezza-giornata.svg' : '/img/mappa-arcipelago.svg';
const alt = mezza
  ? "Mappa dei due percorsi della mezza giornata, con partenza dal porto di La Maddalena e passaggio a Palau per chi si imbarca lì. Giro di Caprera: verso Cala Coticcio sulla costa est di Caprera, Cala Napoletana a nord e I Giardinelli tra La Maddalena e Caprera. Con il maestrale: Cala Corsara a Spargi, Cala Gavetta a La Maddalena e I Giardinelli. Cannigione è più a sud-est, fuori dalla mappa."
  : "Mappa dell'Arcipelago di La Maddalena con il percorso del tour: partenza dal porto di La Maddalena, passaggio a Palau per chi si imbarca lì, Santo Stefano, Caprera, di nuovo La Maddalena per il pranzo, poi Spargi, la Spiaggia Rosa di Budelli vista dal mare, Porto della Madonna tra Budelli, Razzoli e Santa Maria, e rientro.";
---
<figure class="mappa">
  <div class="mappa__area">
    <img
      src={immagine}
      width="1000"
      height="1076"
      loading="lazy"
      alt={alt}
    />
    <div class="mappa__segni" aria-hidden="true">
      <span class="mappa__corsica"><Icona nome="su" size={14} tratto={2.4} />Corsica</span>
      <span class="mappa__nord">
        <span style="display:inline-flex;align-items:center;gap:4px"><Icona nome="su" size={14} tratto={2.4} />N</span>
        <span style="display:flex;flex-direction:column;align-items:flex-end;gap:4px"><span style="display:block;width:56px;height:6px;border:2px solid #282828;border-top:0"></span>2 km</span>
      </span>
      {isole.map((i) => (
        <span class="mappa__isola" style={`left:${i.x}%;top:${i.y}%`} set:html={i.nome} />
      ))}
      <span class="mappa__punto mappa__punto--imbarco mappa__punto--piccolo" style={`left:${passaggioPalau.x}%;top:${passaggioPalau.y}%`}><Icona nome="ancora" size={13} tratto={2.4} /></span>
      {!mezza && <span class="mappa__punto mappa__punto--rosa" style="left:27.07%;top:27.37%"><Icona nome="occhio" size={17} tratto={2.2} /></span>}
      {mezza && <span class="mappa__fuori" style="left:72%;top:96%"><Icona nome="giu" size={14} tratto={2.4} />Cannigione</span>}
      {soste.map((s: any) => (
        <span class={`mappa__punto ${s.largo ? 'mappa__punto--largo' : ''} ${s.turchese ? 'mappa__punto--turchese' : ''}`} style={`left:${s.x}%;top:${s.y}%`}>{s.n}</span>
      ))}
      <span class="mappa__punto mappa__punto--partenza" style={`left:${partenza.x}%;top:${partenza.y}%`}><Icona nome="ancora" size={16} tratto={2.4} /></span>
    </div>
  </div>
  <figcaption class="mappa__legenda">
    {mezza ? (
      <Fragment>
        <span><span class="pallino" aria-hidden="true"></span>Giro di Caprera</span>
        <span><span class="pallino pallino--turchese" aria-hidden="true"></span>Con il maestrale: Spargi e La Maddalena</span>
        <span><span class="pallino pallino--partenza" aria-hidden="true"></span>Partenza da La Maddalena</span>
        <span><span class="pallino pallino--imbarco pallino--piccolo" aria-hidden="true"></span>Passaggio a Palau (puntini)</span>
        <span style="flex-basis:100%">La sosta 3, I Giardinelli, è in tutti e due i percorsi. Da Cannigione il giro è lo stesso, con il gommone dedicato.</span>
      </Fragment>
    ) : (
      <Fragment>
        <span><span class="pallino" aria-hidden="true"></span>Sosta bagno o pranzo</span>
        <span><span class="pallino pallino--rosa" aria-hidden="true"></span>Spiaggia Rosa, solo dal mare</span>
        <span><span class="pallino pallino--partenza" aria-hidden="true"></span>Partenza da La Maddalena</span>
        <span><span class="pallino pallino--imbarco pallino--piccolo" aria-hidden="true"></span>Passaggio a Palau (puntini)</span>
      </Fragment>
    )}
    <span style="flex-basis:100%">{didascalia}</span>
  </figcaption>
</figure>
