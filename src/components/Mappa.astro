---
// Mappa illustrata dell'arcipelago con il percorso del Tour delle 7 isole.
// Le posizioni sono in percentuale sull'immagine (1000 × 1076).
import Icona from './Icona.astro';
interface Props { didascalia?: string }
const { didascalia = 'Percorso indicativo: lo skipper lo adatta a vento e mare.' } = Astro.props;

const isole = [
  { nome: 'La Maddalena', x: 50.99, y: 50.91 },
  { nome: 'Caprera', x: 83.62, y: 68.24 },
  { nome: 'Santo<br>Stefano', x: 52.74, y: 75.01 },
  { nome: 'Spargi', x: 21.85, y: 48.2 },
  { nome: 'Budelli', x: 19.52, y: 24.64 },
  { nome: 'Razzoli', x: 16.61, y: 11.1 },
  { nome: 'Santa<br>Maria', x: 35.26, y: 12.19 },
  { nome: 'Palau', x: 37, y: 88 },
  { nome: 'Sardegna', x: 15.15, y: 94.23 },
];
const soste = [
  { n: '1·4', x: 52.35, y: 66.17, largo: true },
  { n: '2', x: 51.86, y: 82.31 },
  { n: '3', x: 71.08, y: 58.38 },
  { n: '5', x: 25.31, y: 54.63 },
  { n: '6', x: 25.06, y: 18.68 },
  { n: '7', x: 35.12, y: 20.06 },
];
---
<figure class="mappa">
  <div class="mappa__area">
    <img
      src="/img/mappa-arcipelago.svg"
      width="1000"
      height="1076"
      loading="lazy"
      alt="Mappa dell'Arcipelago di La Maddalena con il percorso del tour: da Palau al porto di La Maddalena, Santo Stefano, Caprera, di nuovo La Maddalena per il pranzo, poi Spargi, la Spiaggia Rosa di Budelli vista dal mare, Porto della Madonna tra Budelli, Razzoli e Santa Maria, e rientro."
    />
    <div class="mappa__segni" aria-hidden="true">
      <span class="mappa__corsica"><Icona nome="su" size={14} tratto={2.4} />Corsica</span>
      <span class="mappa__nord">
        <span style="display:inline-flex;align-items:center;gap:4px"><Icona nome="su" size={14} tratto={2.4} />N</span>
        <span style="display:flex;flex-direction:column;align-items:flex-end;gap:4px"><span style="display:block;width:56px;height:6px;border:2px solid #0A3A51;border-top:0"></span>2 km</span>
      </span>
      {isole.map((i) => (
        <span class="mappa__isola" style={`left:${i.x}%;top:${i.y}%`} set:html={i.nome} />
      ))}
      <span class="mappa__punto mappa__punto--imbarco" style="left:41.38%;top:82.52%"><Icona nome="ancora" size={16} tratto={2.4} /></span>
      <span class="mappa__punto mappa__punto--rosa" style="left:27.07%;top:27.37%"><Icona nome="occhio" size={17} tratto={2.2} /></span>
      {soste.map((s) => (
        <span class={`mappa__punto ${s.largo ? 'mappa__punto--largo' : ''}`} style={`left:${s.x}%;top:${s.y}%`}>{s.n}</span>
      ))}
    </div>
  </div>
  <figcaption class="mappa__legenda">
    <span><span class="pallino" aria-hidden="true"></span>Sosta bagno o pranzo</span>
    <span><span class="pallino pallino--rosa" aria-hidden="true"></span>Spiaggia Rosa, solo dal mare</span>
    <span><span class="pallino pallino--imbarco" aria-hidden="true"></span>Imbarco</span>
    <span style="flex-basis:100%">{didascalia}</span>
  </figcaption>
</figure>
