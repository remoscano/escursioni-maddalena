---
// Dati per Google (schema.org, JSON-LD): chi siamo, le escursioni con i prezzi, le domande frequenti, il percorso nel sito.
// Solo dati veri: quelli ancora vuoti in sito.js (indirizzo, P. IVA...) non vengono scritti.
import { sito } from '../data/sito.js';
import { escursioni } from '../data/escursioni.js';
import { offerte, prezzoDa, regole } from '../data/prenotazioni.js';

interface Props {
  tipo: 'attivita' | 'escursione' | 'faq';
  slug?: string;
  domande?: { domanda: string; risposta?: string; regola?: string }[];
}
const { tipo, slug, domande = [] } = Astro.props;
const base = sito.url.replace(/\/$/, '');
const idAttivita = `${base}/#attivita`;

const attivita = {
  '@type': 'LocalBusiness',
  '@id': idAttivita,
  name: sito.nome,
  url: `${base}/`,
  logo: `${base}/img/app-512.png`,
  image: `${base}/img/app-512.png`,
  description: 'Escursioni in maxi gommone con skipper nell\'Arcipelago di La Maddalena: Tour delle 7 isole, mezza giornata, tramonto, tour privati e Corsica.',
  ...(sito.contatti.telefonoVisibile ? { telephone: sito.contatti.telefonoVisibile.replace(/\s/g, '') } : {}),
  ...(sito.contatti.email ? { email: sito.contatti.email } : {}),
  ...(sito.azienda.indirizzo ? { address: { '@type': 'PostalAddress', streetAddress: sito.azienda.indirizzo, addressCountry: 'IT' } } : {}),
  ...(sito.azienda.partitaIva ? { vatID: sito.azienda.partitaIva } : {}),
  areaServed: { '@type': 'Place', name: 'Arcipelago di La Maddalena, Sardegna' },
  priceRange: '€€',
  ...(sito.recensioniGoogle ? { sameAs: [sito.recensioniGoogle] } : {}),
};

let dati: Record<string, unknown>[] = [];
if (tipo === 'attivita') {
  dati = [{ '@context': 'https://schema.org', ...attivita }];
}
if (tipo === 'escursione' && slug) {
  const e = escursioni.find((x) => x.slug === slug)!;
  const o = offerte[slug];
  const prezzo = prezzoDa(slug);
  const soste = (e.programma ?? []).filter((p: any) => p.tipo === 'sosta' || p.tipo === 'vista').map((p: any) => p.titolo);
  dati = [
    {
      '@context': 'https://schema.org',
      '@type': 'TouristTrip',
      name: e.titoloPagina,
      description: e.breve,
      url: `${base}/escursioni/${slug}/`,
      touristType: o?.tipo === 'esclusiva' ? ['Famiglie', 'Gruppi di amici', 'Coppie'] : ['Famiglie', 'Gruppi di amici'],
      provider: { '@id': idAttivita },
      ...(soste.length ? { itinerary: { '@type': 'ItemList', itemListElement: soste.map((nome: string, i: number) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'TouristAttraction', name: nome } })) } } : {}),
      ...(prezzo ? { offers: {
        '@type': 'Offer',
        price: String(prezzo.adulto ?? prezzo.barca),
        priceCurrency: 'EUR',
        description: prezzo.barca ? 'Prezzo da, per il gommone in esclusiva' : 'Prezzo da, a persona',
        url: `${base}/prenota/?escursione=${slug}`,
        availability: regole.attive ? 'https://schema.org/InStock' : 'https://schema.org/PreOrder',
        validFrom: regole.stagione.dal,
        validThrough: regole.stagione.al,
      } } : {}),
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${base}/` },
        { '@type': 'ListItem', position: 2, name: 'Escursioni', item: `${base}/escursioni/` },
        { '@type': 'ListItem', position: 3, name: e.titolo, item: `${base}/escursioni/${slug}/` },
      ],
    },
  ];
}
// Domande frequenti: solo quelle con una risposta già scritta.
const risposte = domande.map((d) => ({ d, r: d.risposta || (d.regola ? (sito.regole as Record<string, string>)[d.regola] : '') })).filter((x) => x.r);
if (risposte.length && (tipo === 'faq' || tipo === 'escursione')) {
  dati.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: risposte.map(({ d, r }) => ({ '@type': 'Question', name: d.domanda, acceptedAnswer: { '@type': 'Answer', text: r } })),
  });
}
---
{dati.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
