---
import ModuloRichiesta from './ModuloRichiesta.astro';
import Dato from './Dato.astro';
import { datiLingua } from '../data/lingua.js';

interface Props { escursione?: string; titolo?: string; titoloModulo?: string; testo?: string; imbarco?: string }
const L = datiLingua(Astro.url);
const T = L.testi.sezioneRichiesta;
const {
  escursione,
  titolo = T.titolo,
  titoloModulo,
  testo,
  imbarco,
} = Astro.props;
const { contatti } = L.sito;
---
<section id="richiesta" class="sezione sezione--scura" aria-labelledby="richiesta-titolo">
  <div class="contenitore">
    <div class="due-colonne">
      <div style="display:flex;flex-direction:column;gap:28px">
        <p class="occhiello">{T.occhiello}</p>
        <h2 id="richiesta-titolo" class="titolo-sezione">{titolo}</h2>
        {testo && <p style="font-size:18px;line-height:1.6;color:#E9ECEF">{testo}</p>}
        <ol class="passi">
          <li><span class="passi__n">1</span><span>{escursione ? T.passo1 : T.passo1Escursione}</span></li>
          <li><span class="passi__n">2</span><span>{T.passo2}</span></li>
          <li><span class="passi__n">3</span><span>{T.passo3}</span></li>
        </ol>
        <p style="font-size:16px;line-height:1.6">
          {T.chiamare}
          {contatti.telefonoVisibile
            ? <a href={`tel:+${contatti.whatsapp}`} style="font-weight:700">{contatti.telefonoVisibile}</a>
            : <Dato e="+39 numero" />}, {T.rispondiamo} <Dato v={contatti.orariRisposta} e="giorni e orari" />.
        </p>
      </div>
      <ModuloRichiesta escursione={escursione} titolo={titoloModulo} imbarco={imbarco} />
    </div>
  </div>
</section>
