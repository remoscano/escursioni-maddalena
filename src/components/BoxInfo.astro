---
import { regole as regoleP } from '../data/prenotazioni.js';
// I quattro riquadri "Prima di salire a bordo": imbarchi, cosa portare, vento e mare, Parco.
import Icona from './Icona.astro';
import Dato from './Dato.astro';
import { datiLingua } from '../data/lingua.js';
const L = datiLingua(Astro.url);
const { sito } = L;
const T = L.testi.boxInfo;
const { imbarchi, regole } = sito;
const porti = [
  { id: 'maddalena', nota: '' },
  { id: 'palau', nota: T.notaPalau },
  { id: 'cannigione', nota: T.notaCannigione },
] as const;
---
<div class="griglia-info">
  <div class="box">
    <span class="box__icona"><Icona nome="luogo" size={24} tratto={1.8} /></span>
    <h3>{T.treImbarchi}</h3>
    {porti.map((p) => (
      <p><strong>{imbarchi[p.id].nome}</strong>{p.nota && ` ${p.nota}`} · <Dato v={imbarchi[p.id].molo} e={T.moloIndirizzo} />, {T.ritrovo(regoleP.anticipoRitrovo[p.id])} ({T.allePrefisso} <Dato v={imbarchi[p.id].ritrovo} e={T.ora} /> {T.usciteMattino})</p>
    ))}
  </div>
  <div class="box">
    <span class="box__icona"><Icona nome="borsa" size={24} tratto={1.8} /></span>
    <h3>{T.cosaPortare}</h3>
    <ul>
      {sito.cosaPortare.map((x: string) => <li>{x}</li>)}
    </ul>
  </div>
  <div class="box">
    <span class="box__icona"><Icona nome="vento" size={24} tratto={1.8} /></span>
    <h3>{T.ventoMare}</h3>
    <p>{T.maestrale}</p>
    <p><Dato v={regole.maltempo} e="La vostra regola: rimborso o cambio data" /></p>
  </div>
  <div class="box">
    <span class="box__icona"><Icona nome="foglia" size={24} tratto={1.8} /></span>
    <h3>{T.parco}</h3>
    <p>{T.regoleParco}</p>
    <p><Dato v={regole.ticketParcoInfo} e="Ticket del Parco: incluso o da pagare" /></p>
  </div>
</div>
