---
import Foto from './Foto.astro';
import Dato from './Dato.astro';
import Icona from './Icona.astro';
import { datiLingua } from '../data/lingua.js';

interface Props { e: any; grande?: boolean }
const { e, grande = false } = Astro.props;
const L = datiLingua(Astro.url);
const T = L.testi.scheda;
const href = L.urlEscursione(e.slug);
const richiesta = L.prenotaOnline ? L.link(`/prenota/?escursione=${e.slug}`) : L.link(`/richiesta/?escursione=${e.slug}`);
const tono = 'acqua';
---
{grande ? (
  <article class="scheda-grande">
    <Foto nota={e.foto.copertina} tono={tono} />
    <div class="scheda-grande__corpo">
      <div class="etichette">{e.etichette.map((t: string) => <span class="etichetta">{t}</span>)}</div>
      <h3><a href={href}>{e.titolo}</a></h3>
      <p class="testo-2" style="font-size:18px">{e.breve}</p>
      <p class="prezzo">
        {T.da} <Dato v={T.euro(e.prezzoAdulti)} e="PREZZO" /> {e.prezzoGommone ? T.aGommone : T.aPersona}
        {e.prezzoBambini !== null && <small>· {T.ridotto} <Dato v={T.euro(e.prezzoBambini)} e="PREZZO" /></small>}
      </p>
      <div class="azioni">
        {L.prenotaOnline
          ? <a href={richiesta} class="btn btn--wa">{T.prenotaOnline}</a>
          : <a href={richiesta} class="btn btn--wa"><Icona nome="whatsapp" />{T.chiediWa}</a>}
        <a href={href} class="btn btn--bordo">{T.scopriTour}<Icona nome="destra" /></a>
      </div>
    </div>
  </article>
) : (
  <article class="scheda">
    <Foto nota={e.foto.copertina} tono={tono} sizes="(max-width: 760px) 100vw, 33vw" />
    <div class="scheda__corpo">
      <div class="etichette">{e.etichette.map((t: string) => <span class="etichetta">{t}</span>)}</div>
      <h3><a href={href}>{e.titolo}</a></h3>
      <p>{e.breve}</p>
      <p class="scheda__info">
        {e.prezzoGommone
          ? <Fragment>{T.finoA}{' '}<Dato v={e.postiMax} e="N" />{` ${T.persone} · ${T.daMinuscolo} `}<Dato v={T.euro(e.prezzoAdulti)} e="PREZZO" />{` ${T.aGommone}`}</Fragment>
          : <Fragment><Dato v={e.orari} e="orari" />{` · ${T.daMinuscolo} `}<Dato v={T.euro(e.prezzoAdulti)} e="PREZZO" /></Fragment>}
      </p>
      <span class="link-freccia" aria-hidden="true">{T.scopriEscursione}<Icona nome="destra" size={18} /></span>
    </div>
  </article>
)}
