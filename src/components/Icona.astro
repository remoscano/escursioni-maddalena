  chiudi: '<path d="M6 6l12 12"/><path d="M18 6 6 18"/>',
  piu: '<path d="M12 5v14"/><path d="M5 12h14"/>',
  spunta: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><path d="M12 8h.01"/>',
  documento: '<rect x="4" y="5" width="16" height="14" rx="2"/><circle cx="9" cy="11" r="2"/><path d="M6.5 16a2.5 2.5 0 0 1 5 0"/><path d="M14 10h3.5"/><path d="M14 13.5h3.5"/>',
