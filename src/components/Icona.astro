const contenuto = icone[nome];
if (!contenuto) throw new Error(`Icona sconosciuta: ${nome}`);
---
<svg
  class={classe}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={tratto}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={contenuto}
/>
