  email: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/>',
  ancora: '<circle cx="12" cy="5" r="2"/><path d="M12 7v14"/><path d="M8.5 11h7"/><path d="M4.5 13.5a7.5 7.5 0 0 0 15 0"/>',
  orologio: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>',
  persone: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 4.6a3.5 3.5 0 0 1 0 6.8"/><path d="M18 14.2a6.5 6.5 0 0 1 3.5 5.8"/>',
  euro: '<path d="M17 6.5A6.5 6.5 0 1 0 17 17.5"/><path d="M4 10.5h9"/><path d="M4 13.5h9"/>',
