  posate: '<path d="M7 3v8"/><path d="M4.5 3v5a2.5 2.5 0 0 0 5 0V3"/><path d="M7 11v10"/><path d="M17 21V3c-2.2 0-3.5 3-3.5 7s1.3 4.5 3.5 4.5"/>',
  foto: '<path d="M4 8h3l2-3h6l2 3h3a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1Z"/><circle cx="12" cy="13.5" r="3.5"/>',
  destra: '<path d="M5 12h14"/><path d="M13 6l6 6-6 6"/>',
  giu: '<path d="M12 5v14"/><path d="M6 13l6 6 6-6"/>',
  su: '<path d="M12 19V5"/><path d="M6 11l6-6 6 6"/>',
